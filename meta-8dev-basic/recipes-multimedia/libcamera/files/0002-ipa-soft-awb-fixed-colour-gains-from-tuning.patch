From c2a8037797890fd31748033cbd0c52a2e27abd86 Mon Sep 17 00:00:00 2001
From: 8devices <support@8devices.com>
Date: Thu, 9 Jul 2026 11:31:50 +0300
Subject: [PATCH] ipa: soft: awb: Support fixed colour gains from tuning

---
 src/ipa/simple/algorithms/awb.cpp | 33 ++++++++++++++++++++++++++++++-
 src/ipa/simple/algorithms/awb.h   |  8 ++++++++
 2 files changed, 40 insertions(+), 1 deletion(-)

diff --git a/src/ipa/simple/algorithms/awb.cpp b/src/ipa/simple/algorithms/awb.cpp
index 195de41..9758303 100644
--- a/src/ipa/simple/algorithms/awb.cpp
+++ b/src/ipa/simple/algorithms/awb.cpp
@@ -12,6 +12,8 @@
 
 #include <libcamera/base/log.h>
 
+#include "libcamera/internal/yaml_parser.h"
+
 #include "simple/ipa_context.h"
 
 namespace libcamera {
@@ -20,11 +22,36 @@ LOG_DEFINE_CATEGORY(IPASoftAwb)
 
 namespace ipa::soft::algorithms {
 
+int Awb::init([[maybe_unused]] IPAContext &context, const YamlObject &tuningData)
+{
+	/*
+	 * Optional fixed white-balance gains as [red, blue]. Used to bypass the
+	 * stats-based grey-world estimation on platforms whose software stats are
+	 * unreliable (e.g. Qualcomm CAMSS raw RDI), where the estimator otherwise
+	 * clamps to a strong magenta cast. Green gain is always 1.0.
+	 */
+	const auto &gains = tuningData["gains"].getList<double>();
+	if (gains && gains->size() == 2) {
+		manualGains_ = { (*gains)[0], (*gains)[1] };
+		LOG(IPASoftAwb, Info)
+			<< "Using fixed AWB gains R/B "
+			<< (*manualGains_)[0] << "/" << (*manualGains_)[1];
+	}
+
+	return 0;
+}
+
 int Awb::configure(IPAContext &context,
 		   [[maybe_unused]] const IPAConfigInfo &configInfo)
 {
 	auto &gains = context.activeState.gains;
-	gains.red = gains.green = gains.blue = 1.0;
+	if (manualGains_) {
+		gains.red = (*manualGains_)[0];
+		gains.green = 1.0;
+		gains.blue = (*manualGains_)[1];
+	} else {
+		gains.red = gains.green = gains.blue = 1.0;
+	}
 
 	return 0;
 }
@@ -35,6 +62,10 @@ void Awb::process(IPAContext &context,
 		  const SwIspStats *stats,
 		  [[maybe_unused]] ControlList &metadata)
 {
+	/* Fixed manual gains: keep the values set in configure(), skip estimation. */
+	if (manualGains_)
+		return;
+
 	const SwIspStats::Histogram &histogram = stats->yHistogram;
 	const uint8_t blackLevel = context.activeState.blc.level;
 
diff --git a/src/ipa/simple/algorithms/awb.h b/src/ipa/simple/algorithms/awb.h
index db1496c..964ca2a 100644
--- a/src/ipa/simple/algorithms/awb.h
+++ b/src/ipa/simple/algorithms/awb.h
@@ -7,6 +7,9 @@
 
 #pragma once
 
+#include <array>
+#include <optional>
+
 #include "algorithm.h"
 
 namespace libcamera {
@@ -19,12 +22,17 @@ public:
 	Awb() = default;
 	~Awb() = default;
 
+	int init(IPAContext &context, const YamlObject &tuningData) override;
 	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
 	void process(IPAContext &context,
 		     const uint32_t frame,
 		     IPAFrameContext &frameContext,
 		     const SwIspStats *stats,
 		     ControlList &metadata) override;
+
+private:
+	/* Fixed [red, blue] gains from tuning; when set, AWB estimation is skipped. */
+	std::optional<std::array<double, 2>> manualGains_;
 };
 
 } /* namespace ipa::soft::algorithms */
-- 
