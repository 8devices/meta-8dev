software =
{
        version = "@@DISTRO_VERSION@@";
        description = "Software update for @@MACHINE@@ device";

        hardware-compatibility = [ "#RE:^0\.[0-9]+$" ];

        stable = {
                a: {
                        images: (
                                {
                                        filename = "8dev-image-base-@@MACHINE@@.rootfs.ext4.gz";
                                        device = "/dev/disk/by-partlabel/system_a";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                },
                                {
                                        filename = "esp-qcom-image-@@MACHINE@@.rootfs.vfat.gz";
                                        device = "/dev/disk/by-partlabel/efi_a";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                },
                                {
                                        filename = "dtb-@@QCOM_DTB_DEFAULT@@-image.vfat";
                                        device = "/dev/disk/by-partlabel/dtb_a";
                                        type = "raw";
                                        installed-directly = true;
                                }
                        );
                        scripts: (
                                {
                                        filename = "change_boot_slot.sh";
                                        type = "postinstall";
                                }
                        );
                };
                b: {
                        images: (
                                {
                                        filename = "8dev-image-base-@@MACHINE@@.rootfs.ext4.gz";
                                        device = "/dev/disk/by-partlabel/system_b";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                },
                                {
                                        filename = "esp-qcom-image-@@MACHINE@@.rootfs.vfat.gz";
                                        device = "/dev/disk/by-partlabel/efi_b";
                                        type = "raw";
                                        compressed = "zlib";
                                        installed-directly = true;
                                },
                                {
                                        filename = "dtb-@@QCOM_DTB_DEFAULT@@-image.vfat";
                                        device = "/dev/disk/by-partlabel/dtb_b";
                                        type = "raw";
                                        installed-directly = true;
                                }
                        );
                        scripts: (
                                {
                                        filename = "change_boot_slot.sh";
                                        type = "postinstall";
                                }
                        );
                };
        };
}
