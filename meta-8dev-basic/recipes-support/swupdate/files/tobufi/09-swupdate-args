active_slot=$(grep -o 'SLOT_SUFFIX=_[ab]' /proc/cmdline | cut -d '=' -f2)

if [ "$active_slot" = "_a" ]; then
    selection='stable,b'
else
    selection='stable,a'
fi

SWUPDATE_ARGS="-H @MACHINE@:0.0 -e ${selection} -f /etc/swupdate.cfg"

# Older SWUs call sgdisk to switch slots; its stand-in goes last on the PATH
# so a real sgdisk still wins.
PATH="$PATH:@LIBDIR@/swupdate/compat"
