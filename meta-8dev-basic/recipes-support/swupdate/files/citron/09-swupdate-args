# Last root= wins (kernel uses the last; UKI baked default first, bootloader appends active slot).
active_slot=$(grep -o 'root=PARTLABEL=system_[ab]' /proc/cmdline | tail -1 | cut -d '_' -f2)

if [ "$active_slot" = "a" ]; then
    selection='stable,b'
else
    selection='stable,a'
fi

SWUPDATE_ARGS="-H @MACHINE@:0.0 -e ${selection} -f /etc/swupdate.cfg"
