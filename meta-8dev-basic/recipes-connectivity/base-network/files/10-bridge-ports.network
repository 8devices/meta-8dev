[Match]
Name=eth*

# Sorts before the stock 80-wired.network so it wins over its per-port DHCP.
# wlan* is deliberately not matched: hostapd bridges those itself, and networkd
# refuses to enslave an AP-mode vif.
[Network]
Bridge=br0

[Link]
# Enslaved ports never go "online"; br0 is the online target.
RequiredForOnline=no
