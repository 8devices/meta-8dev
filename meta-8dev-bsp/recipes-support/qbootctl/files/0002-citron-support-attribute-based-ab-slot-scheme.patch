+/*
+ * Human-readable slot name for output: "a"/"b" (the partition suffix without
+ * the leading underscore), or "none" when the slot is undetermined (slot < 0)
+ * or otherwise invalid. The raw "_a"/"_b" suffix stays internal to partition
+ * naming; only the displayed name is shortened.
+ */
+static const char *slot_name(int slot)
+{
+	const char *s = (slot >= 0) ? impl->getSuffix(slot) : NULL;
+
+	if (!s)
+		return "none";
+	return (s[0] == '_') ? s + 1 : s;
+}
