+static const char *get_slot_ptn_base(void)
+{
+	/*
+	 * Slot-reference partition base. This platform has no Android boot_a/_b,
+	 * so prefer "dtb" (dtb_a/dtb_b) and fall back to "efi" (efi_a/efi_b) when
+	 * the dtb pair is absent OR carries no slot-select attribute (the active
+	 * bit is clear on both dtb_a and dtb_b, i.e. attr left at zero). Returns
+	 * the first base whose active bit is set; otherwise the last existing
+	 * pair; NULL only when neither pair exists.
+	 */
+	static const char *const candidates[] = { "dtb", "efi", NULL };
+	const char *fallback = NULL;
+	char path[PATH_MAX];
+	char part[MAX_GPT_NAME_SIZE + 1];
+	struct stat st;
+	unsigned i;
+
+	for (i = 0; candidates[i] != NULL; i++) {
+		snprintf(path, sizeof(path), "%s/%s%s", BOOTDEV_DIR,
+			 candidates[i], AB_SLOT_A_SUFFIX);
+		if (stat(path, &st) != 0)
+			continue;
+		/* Pair exists - remember it (last existing wins as fallback). */
+		fallback = candidates[i];
+		/* Prefer a base that actually encodes the active slot. */
+		snprintf(part, sizeof(part), "%s%s", candidates[i],
+			 AB_SLOT_A_SUFFIX);
+		if (get_partition_attribute(part, ATTR_SLOT_ACTIVE) == 1)
+			return candidates[i];
+		snprintf(part, sizeof(part), "%s%s", candidates[i],
+			 AB_SLOT_B_SUFFIX);
+		if (get_partition_attribute(part, ATTR_SLOT_ACTIVE) == 1)
+			return candidates[i];
+	}
+	return fallback;
+}
+
 unsigned get_number_slots()
 {
 	struct dirent *de = NULL;
 	DIR *dir_bootdev = NULL;
 	unsigned slot_count = 0;
+	const char *base = get_slot_ptn_base();
+	char ptn_prefix[MAX_GPT_NAME_SIZE];
+	char ptn_aging[MAX_GPT_NAME_SIZE];
+
+	if (!base)
+		return 0;
+	snprintf(ptn_prefix, sizeof(ptn_prefix), "%s_", base);
+	snprintf(ptn_aging, sizeof(ptn_aging), "%s_aging", base);
 
 	dir_bootdev = opendir(BOOTDEV_DIR);
 	if (!dir_bootdev) {
@@ -283,10 +330,10 @@ unsigned get_number_slots()
 			      "Breaking change to slot A suffix");
 		static_assert(AB_SLOT_B_SUFFIX[0] == '_',
 			      "Breaking change to slot B suffix");
-		if (!strncmp(de->d_name, BOOT_IMG_PTN_NAME,
-			     strlen(BOOT_IMG_PTN_NAME)) &&
-		    !!strncmp(de->d_name, "boot_aging\n",
-			      strlen("boot_aging"))) {
+		if (!strncmp(de->d_name, ptn_prefix,
+			     strlen(ptn_prefix)) &&
+		    !!strncmp(de->d_name, ptn_aging,
+			      strlen(ptn_aging))) {
 			slot_count++;
 		}
 	}
@@ -298,36 +345,40 @@ error:
 	return 0;
 }
 
