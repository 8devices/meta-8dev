# SPDX-License-Identifier: MIT
define KMACHINE tobufi
define KTYPE standard
define KARCH arm64
define KMETA_EXTERNAL_BSP t

kconf hardware tobufi-standard.cfg
kconf hardware cpufreq-gov-performance.cfg
kconf hardware enable-gpio-fan-thermal-control.cfg

patch enable-qcom-gdsc-for-qcs404-gcc.patch
patch auto-enable-cpufreq_dt-for-arm_qcom_cpufreq_nvmem.patch
patch add-generic-virtual-thermal-zones-driver-to-kernel.patch
patch update-reset-reason-shift-for-pms405-pon.patch
patch allow-board-variant-override-via-ath11k-module-param.patch
patch extcon-usb-gpio-add-VBUS-boost-support.patch
patch allow-MAC-addr-override-via-module-params.patch
patch msm-serial-add-additional-2-uart-ports.patch
