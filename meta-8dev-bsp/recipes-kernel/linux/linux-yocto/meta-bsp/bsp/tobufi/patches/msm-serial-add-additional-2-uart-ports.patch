From: =?UTF-8?q?Simonas=20Sku=C4=8Das?= <simonas.s@8devices.com>
Date: Mon, 13 Oct 2025 06:16:30 +0000
Subject: [PATCH] msm_serial: add additional 2 uart ports
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Add one port for BLSP5, and another for Bluetooth port (TOB_100)

Signed-off-by: Simonas Skučas <simonas.s@8devices.com>
---
 drivers/tty/serial/msm_serial.c | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/drivers/tty/serial/msm_serial.c b/drivers/tty/serial/msm_serial.c
diff --git a/drivers/tty/serial/msm_serial.c b/drivers/tty/serial/msm_serial.c
From b037ac62c561735030283c430c3ab33900b1cb77 Mon Sep 17 00:00:00 2001
--- a/drivers/tty/serial/msm_serial.c
+++ b/drivers/tty/serial/msm_serial.c
@@ -1584,6 +1584,24 @@ static struct msm_port msm_uart_ports[] = {
 			.line = 2,
 		},
 	},
+	{
+		.uart = {
+			.iotype = UPIO_MEM,
+			.ops = &msm_uart_pops,
+			.flags = UPF_BOOT_AUTOCONF,
+			.fifosize = 64,
+			.line = 3,
+		},
+	},
+	{
+		.uart = {
+			.iotype = UPIO_MEM,
+			.ops = &msm_uart_pops,
+			.flags = UPF_BOOT_AUTOCONF,
+			.fifosize = 64,
+			.line = 4,
+		},
+	},
 };
 
 #define MSM_UART_NR	ARRAY_SIZE(msm_uart_ports)
-- 
2.25.1

