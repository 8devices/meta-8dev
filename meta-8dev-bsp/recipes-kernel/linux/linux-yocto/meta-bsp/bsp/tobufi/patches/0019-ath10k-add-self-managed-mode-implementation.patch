+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+static inline enum cc_setting_code
+ath10k_wmi_cc_setting_code_to_reg(u32 status_code)
+{
+	switch (status_code) {
+	case 0:
+		return REG_SET_CC_STATUS_PASS;
+	case 1:
+		return REG_CURRENT_ALPHA2_NOT_FOUND;
+	case 2:
+		return REG_INIT_ALPHA2_NOT_FOUND;
+	case 3:
+		return REG_SET_CC_CHANGE_NOT_ALLOWED;
+	case 4:
+		return REG_SET_CC_STATUS_NO_MEMORY;
+	case 5:
+		return REG_SET_CC_STATUS_FAIL;
+	default:
+		return REG_SET_CC_STATUS_FAIL;
+	}
+}
+
+/**
+ * create_reg_rules_from_wmi() - Convert WMI regulatory rules to kernel format
+ * @num_reg_rules: Number of regulatory rules to convert
+ * @wmi_reg_rule: Pointer to WMI regulatory rule structures
+ *
+ * Parses WMI regulatory rules from firmware and converts them to kernel's
+ * cur_reg_rule format.
+ *
+ * Return: Pointer to allocated reg_rule array, or NULL on failure
+ */
+static struct cur_reg_rule *
+create_reg_rules_from_wmi(u32 num_reg_rules, struct wmi_regulatory_rule_struct *wmi_reg_rule)
+{
+	struct cur_reg_rule *reg_rule_ptr;
+	u32 count;
+
+	reg_rule_ptr = kcalloc(num_reg_rules, sizeof(*reg_rule_ptr),
+			       GFP_ATOMIC);
+
+	if (!reg_rule_ptr)
+		return NULL;
+
+	for (count = 0; count < num_reg_rules; count++) {
+		reg_rule_ptr[count].start_freq =
+			FIELD_GET(REG_RULE_START_FREQ,
+				  __le32_to_cpu(wmi_reg_rule[count].freq_info));
+		reg_rule_ptr[count].end_freq =
+			FIELD_GET(REG_RULE_END_FREQ,
+				  __le32_to_cpu(wmi_reg_rule[count].freq_info));
+		reg_rule_ptr[count].max_bw =
+			FIELD_GET(REG_RULE_MAX_BW,
+				  __le32_to_cpu(wmi_reg_rule[count].bw_pwr_info));
+		reg_rule_ptr[count].reg_power =
+			FIELD_GET(REG_RULE_REG_PWR,
+				  __le32_to_cpu(wmi_reg_rule[count].bw_pwr_info));
+		reg_rule_ptr[count].ant_gain =
+			FIELD_GET(REG_RULE_ANT_GAIN,
+				  __le32_to_cpu(wmi_reg_rule[count].bw_pwr_info));
+		reg_rule_ptr[count].flags =
+			FIELD_GET(REG_RULE_FLAGS,
+				  __le32_to_cpu(wmi_reg_rule[count].flag_info));
+	}
+
+	return reg_rule_ptr;
+}
+#endif
