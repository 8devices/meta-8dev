+
+#ifndef ATH10K_REG_H
+#define ATH10K_REG_H
+
+#include <linux/kernel.h>
+#include <net/regulatory.h>
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+
+/* World regdom to be used in case default regd from fw is unavailable */
+#define ATH10K_2GHZ_CH01_11      REG_RULE(2412 - 10, 2462 + 10, 40, 0, 20, 0)
+#define ATH10K_5GHZ_5150_5350    REG_RULE(5150 - 10, 5350 + 10, 80, 0, 30,\
+					  NL80211_RRF_NO_IR)
+#define ATH10K_5GHZ_5725_5850    REG_RULE(5725 - 10, 5850 + 10, 80, 0, 30,\
+					  NL80211_RRF_NO_IR)
+
+struct ath10k;
+
+static const struct ieee80211_regdomain ath10k_world_regd = {
+	.n_reg_rules = 3,
+	.alpha2 =  "00",
+	.reg_rules = {
+		ATH10K_2GHZ_CH01_11,
+		ATH10K_5GHZ_5150_5350,
+		ATH10K_5GHZ_5725_5850,
+	}
+};
+
+/* DFS regdomains supported by Firmware */
+enum ath10k_dfs_region {
+	ATH10K_DFS_REG_UNSET,
+	ATH10K_DFS_REG_FCC,
+	ATH10K_DFS_REG_ETSI,
+	ATH10K_DFS_REG_MKK,
+	ATH10K_DFS_REG_CN,
+	ATH10K_DFS_REG_KR,
+	ATH10K_DFS_REG_MKK_N,
+	ATH10K_DFS_REG_UNDEF,
+};
+
+/* ATH10K Regulatory API's */
+void ath10k_reg_init(struct ath10k *ar);
+void ath10k_reg_update_work(struct work_struct *work);
+void ath10k_reg_fallback_work(struct work_struct *work);
+struct ieee80211_regdomain * ath10k_reg_build_regd(struct ath10k *ar, struct cur_regulatory_info *reg_info, bool intersect);
+int ath10k_reg_update(struct ath10k *ar);
+#else
+static inline void ath10k_reg_init(struct ath10k *ar) {}
+static inline void ath10k_reg_update_work(struct work_struct *work) {}
+static inline void ath10k_reg_fallback_work(struct work_struct *work) {}
+static inline struct ieee80211_regdomain * ath10k_re_build_regd(struct ath10k *ar, struct cur_regulatory_info *reg_info, bool intersect)
+{
+	return NULL;
+}
+static inline int ath10k_reg_update(struct ath10k *ar) { return 0; }
+#endif
+#endif
diff --git a/drivers/net/wireless/ath/ath10k/wmi-ops.h b/drivers/net/wireless/ath/ath10k/wmi-ops.h
index aa57d807491c..76a858871f47 100644
