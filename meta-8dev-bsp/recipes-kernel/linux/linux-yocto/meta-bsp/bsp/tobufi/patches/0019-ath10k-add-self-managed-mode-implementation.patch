 {
 	lockdep_assert_held(&ar->conf_mutex);
 	ath10k_debug_stop(ar);
-
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+	cancel_work_sync(&ar->regd_update_work);
+	cancel_work_sync(&ar->reg_fallback_work);
+#endif
 	/* try to suspend target */
 	if (ar->state != ATH10K_STATE_RESTARTING &&
 	    ar->state != ATH10K_STATE_UTF)
@@ -3659,7 +3662,10 @@ struct ath10k *ath10k_core_create(size_t priv_size, struct device *dev,
 	INIT_WORK(&ar->restart_work, ath10k_core_restart);
 	INIT_WORK(&ar->set_coverage_class_work,
 		  ath10k_core_set_coverage_class_work);
-
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+	INIT_WORK(&ar->regd_update_work, ath10k_reg_update_work);
+	INIT_WORK(&ar->reg_fallback_work, ath10k_reg_fallback_work);
+#endif
 	init_dummy_netdev(&ar->napi_dev);
 
 	ret = ath10k_coredump_create(ar);
