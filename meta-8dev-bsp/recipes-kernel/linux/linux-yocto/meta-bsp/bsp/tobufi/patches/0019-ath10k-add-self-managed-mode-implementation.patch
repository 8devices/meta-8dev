+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+static int ath10k_wmi_tlv_op_pull_reg_chan_cc_list_ev(struct ath10k *ar, struct sk_buff *skb, struct cur_regulatory_info *reg_info)
+{
+	const void **tb;
+	const struct wmi_reg_chan_cc_list_event *ev;
+	struct wmi_regulatory_rule_struct *wmi_reg_rule;
+	u32 num_2ghz_reg_rules, num_5ghz_reg_rules;
+	int ret;
+
+	tb = ath10k_wmi_tlv_parse_alloc(ar, skb->data, skb->len, GFP_ATOMIC);
+	if (IS_ERR(tb)) {
+		ret = PTR_ERR(tb);
+		ath10k_warn(ar, "failed to parse tlv: %d\n", ret);
+		return ret;
+	}
+
+	ev = tb[WMI_TLV_TAG_STRUCT_REG_CHAN_LIST_CC_EVENT];
+	if (!ev) {
+		kfree(tb);
+		return -EPROTO;
+	}
+
+	reg_info->num_2ghz_reg_rules = __le32_to_cpu(ev->num_2ghz_reg_rules);
+	reg_info->num_5ghz_reg_rules = __le32_to_cpu(ev->num_5ghz_reg_rules);
+
+	if (!(reg_info->num_2ghz_reg_rules + reg_info->num_5ghz_reg_rules)) {
+		ath10k_warn(ar, "No regulatory rules available in the event info\n");
+		return -EINVAL;
+	}
+
+	memcpy(reg_info->alpha2, &ev->alpha2,
+	       REG_ALPHA2_LEN);
+
+	reg_info->dfs_region = __le32_to_cpu(ev->dfs_region);
+	reg_info->phybitmap = __le32_to_cpu(ev->phybitmap);
+	reg_info->num_phy = __le32_to_cpu(ev->num_phy);
+	reg_info->phy_id = __le32_to_cpu(ev->phy_id);
+	reg_info->ctry_code = __le32_to_cpu(ev->country_id);
+	reg_info->reg_dmn_pair = __le32_to_cpu(ev->domain_code);
+	reg_info->status_code = ath10k_wmi_cc_setting_code_to_reg(__le32_to_cpu(ev->status_code));
+	ath10k_dbg(ar, ATH10K_DBG_WMI, "status_code %d", reg_info->status_code);
+
+	reg_info->min_bw_2ghz = __le32_to_cpu(ev->min_bw_2ghz);
+	reg_info->max_bw_2ghz = __le32_to_cpu(ev->max_bw_2ghz);
+	reg_info->min_bw_5ghz = __le32_to_cpu(ev->min_bw_5ghz);
+	reg_info->max_bw_5ghz = __le32_to_cpu(ev->max_bw_5ghz);
+
+	num_2ghz_reg_rules = reg_info->num_2ghz_reg_rules;
+	num_5ghz_reg_rules = reg_info->num_5ghz_reg_rules;
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Firmware regulatory event: Country=%c%c DFS_region=%d\n",
+		    reg_info->alpha2[0], reg_info->alpha2[1], reg_info->dfs_region);
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "  Bandwidth limits: 2GHz [%d-%d] MHz, 5GHz [%d-%d] MHz\n",
+		    reg_info->min_bw_2ghz, reg_info->max_bw_2ghz,
+		    reg_info->min_bw_5ghz, reg_info->max_bw_5ghz);
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "  Regulatory rules: 2GHz=%d rules, 5GHz=%d rules\n",
+		    num_2ghz_reg_rules, num_5ghz_reg_rules);
+
+	wmi_reg_rule = (struct wmi_regulatory_rule_struct *)((u8 *)ev
+					+ sizeof(*ev) + WMI_TLV_HDR_SIZE);
+
+	if (num_2ghz_reg_rules) {
+		reg_info->reg_rules_2ghz_ptr =
+				create_reg_rules_from_wmi(num_2ghz_reg_rules,
+							  wmi_reg_rule);
+		if (!reg_info->reg_rules_2ghz_ptr) {
+			ath10k_warn(ar, "Unable to Allocate memory for 2 GHz rules\n");
+			return -ENOMEM;
+		}
+	}
+
+	if (num_5ghz_reg_rules) {
+		wmi_reg_rule += num_2ghz_reg_rules;
+		reg_info->reg_rules_5ghz_ptr =
+				create_reg_rules_from_wmi(num_5ghz_reg_rules,
+							  wmi_reg_rule);
+		if (!reg_info->reg_rules_5ghz_ptr) {
+			ath10k_warn(ar, "Unable to Allocate memory for 5 GHz rules\n");
+			return -ENOMEM;
+		}
+	}
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "processed regulatory channel list\n");
+
+	kfree(tb);
+	return 0;
+}
+#endif
