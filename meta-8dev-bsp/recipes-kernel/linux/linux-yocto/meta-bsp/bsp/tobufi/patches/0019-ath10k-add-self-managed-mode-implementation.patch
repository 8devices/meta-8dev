Date: Mon, 17 Nov 2025 07:36:20 +0000
Subject: [PATCH] ath10k: add self-managed mode implementation
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

All changes are based on ath11k driver. Mainly on these files:
 * * drivers/net/wireless/ath/ath11k/core.h
 * * drivers/net/wireless/ath/ath11k/core.c
 * * drivers/net/wireless/ath/ath11k/mac.h
 * * drivers/net/wireless/ath/ath11k/mac.c
 * * drivers/net/wireless/ath/ath11k/reg.h
 * * drivers/net/wireless/ath/ath11k/reg.c
 * * drivers/net/wireless/ath/ath11k/wmi.h
 * * drivers/net/wireless/ath/ath11k/wmi.c
 * Copyright (c) 2018-2019 The Linux Foundation. All rights reserved.
 * Copyright (c) 2021-2023 Qualcomm Innovation Center, Inc. All rights reserved.

Upstream-Status: Pending
Signed-off-by: Giedrė Šimkūnaitė <giedre.s@8devices.com>
---
 drivers/net/wireless/ath/ath10k/Kconfig   |  15 +
 drivers/net/wireless/ath/ath10k/Makefile  |   3 +-
 drivers/net/wireless/ath/ath10k/core.c    |  10 +-
 drivers/net/wireless/ath/ath10k/core.h    |  22 +
 drivers/net/wireless/ath/ath10k/mac.c     |  73 ++-
 drivers/net/wireless/ath/ath10k/mac.h     |   1 +
 drivers/net/wireless/ath/ath10k/reg.c     | 632 ++++++++++++++++++++++
 drivers/net/wireless/ath/ath10k/reg.h     |  66 +++
 drivers/net/wireless/ath/ath10k/wmi-ops.h |  38 ++
 drivers/net/wireless/ath/ath10k/wmi-tlv.c | 205 +++++++
 drivers/net/wireless/ath/ath10k/wmi-tlv.h |  42 ++
 drivers/net/wireless/ath/ath10k/wmi.c     | 127 +++++
 drivers/net/wireless/ath/ath10k/wmi.h     |  78 +++
 13 files changed, 1304 insertions(+), 8 deletions(-)
 create mode 100644 drivers/net/wireless/ath/ath10k/reg.c
 create mode 100644 drivers/net/wireless/ath/ath10k/reg.h

diff --git a/drivers/net/wireless/ath/ath10k/Kconfig b/drivers/net/wireless/ath/ath10k/Kconfig
index 4f385f4a8cef..87aa6f6a11c1 100644
--- a/drivers/net/wireless/ath/ath10k/Kconfig
+++ b/drivers/net/wireless/ath/ath10k/Kconfig
@@ -52,6 +52,21 @@ config ATH10K_SNOC
 	  This module adds support for integrated WCN3990 chip connected
 	  to system NOC(SNOC).
 
+config ATH10K_REG_OFFLOAD
+	bool "Enable ath10k self-managed mode"
+	depends on ATH10K
+	help
+	  This feature sets ath10k driver to self-managed mode. In self-managed mode ath10k
+	  driver reads regulatory data from device firmware. 
+
+	  If this feature enabled - firmware controls ath10k driver regulatory data settings. 
+	  
+	  If this feature is disabled - kernel controls ath10k driver regulatory data.
+
+	  DISCLAIMER: make sure your device firmware supports regulatory data reading event.
+
+	  If unsure say N.
+
 config ATH10K_DEBUG
 	bool "Atheros ath10k debugging"
 	depends on ATH10K
diff --git a/drivers/net/wireless/ath/ath10k/Makefile b/drivers/net/wireless/ath/ath10k/Makefile
index 142c777b287f..acd4530bd1a2 100644
--- a/drivers/net/wireless/ath/ath10k/Makefile
+++ b/drivers/net/wireless/ath/ath10k/Makefile
