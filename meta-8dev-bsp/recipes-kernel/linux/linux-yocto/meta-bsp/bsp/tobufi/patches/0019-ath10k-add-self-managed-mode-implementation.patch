diff --git a/drivers/net/wireless/ath/ath10k/reg.c b/drivers/net/wireless/ath/ath10k/reg.c
new file mode 100644
index 000000000000..642ab0dfb26d
--- /dev/null
+++ b/drivers/net/wireless/ath/ath10k/reg.c
@@ -0,0 +1,632 @@
+// SPDX-License-Identifier: BSD-3-Clause-Clear
+/* Based on ath11k:
+ * * ath11k/reg.h:
+ * Copyright (c) 2019 The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * * ath11k/reg.c:
+ * Copyright (c) 2018-2019 The Linux Foundation. All rights reserved.
+ * Copyright (c) 2021-2023 Qualcomm Innovation Center, Inc. All rights reserved.
+ * Author: Giedrė Šimkūnaitė <giedre.s@8devices.com>
+ */
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+#include <linux/rtnetlink.h>
+
+#include "core.h"
+#include "debug.h"
+#include "wmi-ops.h"
+#include "mac.h"
+
+#define ETSI_WEATHER_RADAR_BAND_LOW		5590
+#define ETSI_WEATHER_RADAR_BAND_HIGH		5650
+#define ETSI_WEATHER_RADAR_BAND_CAC_TIMEOUT	600000
+
+/**
+ * ath10k_regdom_changes() - Check if regulatory domain is changing
+ * @ar: ath10k device
+ * @alpha2: Two-character country code
+ *
+ * Return: true if regulatory domain is changing, false otherwise
+ */
+static bool ath10k_regdom_changes(struct ath10k *ar, char *alpha2)
+{
+	const struct ieee80211_regdomain *regd;
+
+	regd = rcu_dereference_rtnl(ar->hw->wiphy->regd);
+	/* This can happen during wiphy registration where the previous
+	 * user request is received before we update the regd received
+	 * from firmware.
+	 */
+	if (!regd)
+		return true;
+
+	return memcmp(regd->alpha2, alpha2, 2) != 0;
+}
+
+static void ath10k_reg_notifier_sf(struct wiphy *wiphy, struct regulatory_request *request)
+{
+	struct ieee80211_hw *hw = wiphy_to_ieee80211_hw(wiphy);
+	struct ath10k *ar = hw->priv;
+	struct cur_set_current_country_params set_current_param = {};
+	int ret;
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Regulatory Notification received for %s\n", wiphy_name(wiphy));
+
+	/* Currently supporting only General User Hints. Cell base user
+	 * hints to be handled later.
+	 * Hints from other sources like Core, Beacons are not expected for
+	 * self managed wiphy's
+	 */
+
+	/* Don't send commands during boot/initialization.*/
+	if (ar->state != ATH10K_STATE_ON) {
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Device not ready (state=%d), skipping country update\n", ar->state);
+		return;
+	}
+
+	if (!(request->initiator == NL80211_REGDOM_SET_BY_USER && request->user_reg_hint_type == NL80211_USER_REG_HINT_USER)) {
+		ath10k_warn(ar, "Unexpected Regulatory event for this wiphy\n");
+		return;
+	}
+
+	if (!IS_ENABLED(CONFIG_ATH_REG_DYNAMIC_USER_REG_HINTS)) {
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Country Setting is not allowed\n");
+		return;
+	}
+
+	if (!ath10k_regdom_changes(ar, request->alpha2)) {
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Country is already set\n");
+		return;
+	}
+
+	/* Set the country code to the firmware and will receive
+	 * the WMI_REG_CHAN_LIST_CC EVENT for updating the
+	 * reg info
+	 */
+	memcpy(&set_current_param.alpha2, request->alpha2, 2);
+	set_current_param.alpha2[2] = '\0';
+
+	spin_lock_bh(&ar->data_lock);
+	memcpy(&ar->alpha2, &set_current_param.alpha2, 3);
+	spin_unlock_bh(&ar->data_lock);
+
+	ret = ath10k_wmi_set_current_country_cmd(ar, &set_current_param);
+	if (ret) {
+		ath10k_warn(ar, "failed set current country code: %d\n", ret);
+		return;
+	}
+
+	ar->regdom_set_by_user = true;
+
+	ath10k_info(ar, "User requested country %c%c (regulatory update will come from firmware)\n", request->alpha2[0], request->alpha2[1]);
+}
+
+static void ath10k_copy_regd(struct ieee80211_regdomain *regd_orig, struct ieee80211_regdomain *regd_copy)
+{
+	u8 i;
+
+	/* The caller should have checked error conditions */
+	memcpy(regd_copy, regd_orig, sizeof(*regd_orig));
+
+	for (i = 0; i < regd_orig->n_reg_rules; i++)
+		memcpy(&regd_copy->reg_rules[i], &regd_orig->reg_rules[i], sizeof(struct ieee80211_reg_rule));
+}
+
+int ath10k_reg_update(struct ath10k *ar)
+{
+	struct ieee80211_regdomain *regd, *regd_copy = NULL;
+	int ret, regd_len;
+
+	spin_lock_bh(&ar->data_lock);
+
+	/* Prefer the latest regd update over default if it's available */
+	if (ar->new_regd) {
+		regd = ar->new_regd;
+	} else {
+		/* Apply the regd received during init through
+		 * WMI_REG_CHAN_LIST_CC event. In case of failure to
+		 * receive the regd, initialize with a default world
+		 * regulatory.
+		 */
+		if (ar->default_regd) {
+			regd = ar->default_regd;
+		} else {
+			ath10k_warn(ar, "failed to receive default regd during init\n");
+			regd = (struct ieee80211_regdomain *)&ath10k_world_regd;
+		}
+	}
+
+	if (!regd) {
+		ret = -EINVAL;
+		spin_unlock_bh(&ar->data_lock);
+		goto err;
+	}
+
+	regd_len = sizeof(*regd) + (regd->n_reg_rules * sizeof(struct ieee80211_reg_rule));
+
+	regd_copy = kzalloc(regd_len, GFP_ATOMIC);
+	if (regd_copy)
+		ath10k_copy_regd(regd, regd_copy);
+
+	spin_unlock_bh(&ar->data_lock);
+
+	if (!regd_copy) {
+		ret = -ENOMEM;
+		goto err;
+	}
+
+	/* Use non-sync version like ath11k to avoid RTNL assertion.
+	 * This function handles RTNL locking internally when needed.
+	 */
+	ret = regulatory_set_wiphy_regd(ar->hw->wiphy, regd_copy);
+
+	kfree(regd_copy);
+
+	if (ret)
+		goto err;
+
+	if (ar->state == ATH10K_STATE_ON) {
+		ret = ath10k_update_channel_list(ar, true);
+		if (ret)
+			goto err;
+	}
+
+	/* Note: ar->new_regd is NOT freed here. It remains allocated until
+	 * the next regulatory update from firmware (see ath10k_reg_chan_list_event)
+	 * or until driver cleanup. This matches ath11k behavior.
+	 */
+
+	return 0;
+err:
+	ath10k_warn(ar, "failed to perform regd update: %d\n", ret);
+	return ret;
+}
+
+static enum nl80211_dfs_regions ath10k_map_fw_dfs_region(enum ath10k_dfs_region dfs_region)
+{
+	switch (dfs_region) {
+	case ATH10K_DFS_REG_FCC:
+	case ATH10K_DFS_REG_CN:
+		return NL80211_DFS_FCC;
+	case ATH10K_DFS_REG_ETSI:
+	case ATH10K_DFS_REG_KR:
+		return NL80211_DFS_ETSI;
+	case ATH10K_DFS_REG_MKK:
+	case ATH10K_DFS_REG_MKK_N:
+		return NL80211_DFS_JP;
+	default:
+		return NL80211_DFS_UNSET;
+	}
+}
+
+static u32 ath10k_map_fw_reg_flags(u16 reg_flags)
+{
+	u32 flags = 0;
+
+	if (reg_flags & REGULATORY_CHAN_NO_IR)
+		flags |= NL80211_RRF_NO_IR;
+
+	if (reg_flags & REGULATORY_CHAN_RADAR)
+		flags |= NL80211_RRF_DFS;
+
+	if (reg_flags & REGULATORY_CHAN_NO_OFDM)
+		flags |= NL80211_RRF_NO_OFDM;
+
+	if (reg_flags & REGULATORY_CHAN_INDOOR_ONLY)
+		flags |= NL80211_RRF_NO_OUTDOOR;
+
+	if (reg_flags & REGULATORY_CHAN_NO_HT40)
+		flags |= NL80211_RRF_NO_HT40;
+
+	if (reg_flags & REGULATORY_CHAN_NO_80MHZ)
+		flags |= NL80211_RRF_NO_80MHZ;
+
+	if (reg_flags & REGULATORY_CHAN_NO_160MHZ)
+		flags |= NL80211_RRF_NO_160MHZ;
+
+	return flags;
+}
+
+static bool ath10k_reg_can_intersect(struct ieee80211_reg_rule *rule1, struct ieee80211_reg_rule *rule2)
+{
+	u32 start_freq1, end_freq1;
+	u32 start_freq2, end_freq2;
+
+	start_freq1 = rule1->freq_range.start_freq_khz;
+	start_freq2 = rule2->freq_range.start_freq_khz;
+
+	end_freq1 = rule1->freq_range.end_freq_khz;
+	end_freq2 = rule2->freq_range.end_freq_khz;
+
+	if ((start_freq1 >= start_freq2 && start_freq1 < end_freq2) ||
+	    (start_freq2 > start_freq1 && start_freq2 < end_freq1))
+		return true;
+
+	return false;
+}
+
+/**
+ * ath10k_reg_intersect_rules() - Intersect two regulatory rules
+ * @rule1: First regulatory rule
+ * @rule2: Second regulatory rule
+ * @new_rule: Output rule containing intersection
+ *
+ * Creates a new rule that is the intersection of rule1 and rule2,
+ * taking the most restrictive values from both.
+ */
+static void ath10k_reg_intersect_rules(struct ieee80211_reg_rule *rule1, struct ieee80211_reg_rule *rule2, struct ieee80211_reg_rule *new_rule)
+{
+	u32 start_freq1, end_freq1;
+	u32 start_freq2, end_freq2;
+	u32 freq_diff, max_bw;
+
+	start_freq1 = rule1->freq_range.start_freq_khz;
+	start_freq2 = rule2->freq_range.start_freq_khz;
+
+	end_freq1 = rule1->freq_range.end_freq_khz;
+	end_freq2 = rule2->freq_range.end_freq_khz;
+
+	new_rule->freq_range.start_freq_khz = max_t(u32, start_freq1, start_freq2);
+	new_rule->freq_range.end_freq_khz = min_t(u32, end_freq1, end_freq2);
+
+	freq_diff = new_rule->freq_range.end_freq_khz - new_rule->freq_range.start_freq_khz;
+	max_bw = min_t(u32, rule1->freq_range.max_bandwidth_khz, rule2->freq_range.max_bandwidth_khz);
+	new_rule->freq_range.max_bandwidth_khz = min_t(u32, max_bw, freq_diff);
+
+	new_rule->power_rule.max_antenna_gain = min_t(u32, rule1->power_rule.max_antenna_gain, rule2->power_rule.max_antenna_gain);
+
+	new_rule->power_rule.max_eirp = min_t(u32, rule1->power_rule.max_eirp, rule2->power_rule.max_eirp);
+
+	/* Use the flags of both the rules */
+	new_rule->flags = rule1->flags | rule2->flags;
+
+	/* To be safe, use the max cac timeout of both rules */
+	new_rule->dfs_cac_ms = max_t(u32, rule1->dfs_cac_ms, rule2->dfs_cac_ms);
+}
+
+static struct ieee80211_regdomain *ath10k_reg_intersect(struct ieee80211_regdomain *default_regd, struct ieee80211_regdomain *curr_regd)
+{
+	u8 num_old_regd_rules, num_curr_regd_rules, num_new_regd_rules;
+	struct ieee80211_reg_rule *old_rule, *curr_rule, *new_rule;
+	struct ieee80211_regdomain *new_regd = NULL;
+	u8 i, j, k;
+
+	num_old_regd_rules = default_regd->n_reg_rules;
+	num_curr_regd_rules = curr_regd->n_reg_rules;
+	num_new_regd_rules = 0;
+
+	/* Find the number of intersecting rules to allocate new regd memory */
+	for (i = 0; i < num_old_regd_rules; i++) {
+		old_rule = default_regd->reg_rules + i;
+		for (j = 0; j < num_curr_regd_rules; j++) {
+			curr_rule = curr_regd->reg_rules + j;
+
+			if (ath10k_reg_can_intersect(old_rule, curr_rule))
+				num_new_regd_rules++;
+		}
+	}
+
+	if (!num_new_regd_rules)
+		return NULL;
+
+	new_regd = kzalloc(sizeof(*new_regd) + (num_new_regd_rules * sizeof(struct ieee80211_reg_rule)), GFP_ATOMIC);
+
+	if (!new_regd)
+		return NULL;
+
+	/* We set the new country and dfs region directly and only trim
+	 * the freq, power, antenna gain by intersecting with the
+	 * default regdomain. Also MAX of the dfs cac timeout is selected.
+	 */
+	new_regd->n_reg_rules = num_new_regd_rules;
+	memcpy(new_regd->alpha2, curr_regd->alpha2, sizeof(new_regd->alpha2));
+	new_regd->dfs_region = curr_regd->dfs_region;
+	new_rule = new_regd->reg_rules;
+
+	for (i = 0, k = 0; i < num_old_regd_rules; i++) {
+		old_rule = default_regd->reg_rules + i;
+		for (j = 0; j < num_curr_regd_rules; j++) {
+			curr_rule = curr_regd->reg_rules + j;
+
+			if (ath10k_reg_can_intersect(old_rule, curr_rule))
+				ath10k_reg_intersect_rules(old_rule, curr_rule, (new_rule + k++));
+		}
+	}
+	return new_regd;
+}
+
+static const char * ath10k_reg_get_regdom_str(enum nl80211_dfs_regions dfs_region)
+{
+	switch (dfs_region) {
+	case NL80211_DFS_FCC:
+		return "FCC";
+	case NL80211_DFS_ETSI:
+		return "ETSI";
+	case NL80211_DFS_JP:
+		return "JP";
+	default:
+		return "UNSET";
+	}
+}
+
+static u16 ath10k_reg_adjust_bw(u16 start_freq, u16 end_freq, u16 max_bw)
+{
+	u16 bw;
+
+	if (end_freq <= start_freq)
+		return 0;
+
+	bw = end_freq - start_freq;
+	bw = min_t(u16, bw, max_bw);
+
+	if (bw >= 80 && bw < 160)
+		bw = 80;
+	else if (bw >= 40 && bw < 80)
+		bw = 40;
+	else if (bw >= 20 && bw < 40)
+		bw = 20;
+	else
+		bw = 0;
+
+	return bw;
+}
+
+static void ath10k_reg_update_rule(struct ieee80211_reg_rule *reg_rule, u32 start_freq, u32 end_freq, u32 bw, u32 ant_gain, u32 reg_pwr, u32 reg_flags)
+{
+	reg_rule->freq_range.start_freq_khz = MHZ_TO_KHZ(start_freq);
+	reg_rule->freq_range.end_freq_khz = MHZ_TO_KHZ(end_freq);
+	reg_rule->freq_range.max_bandwidth_khz = MHZ_TO_KHZ(bw);
+	reg_rule->power_rule.max_antenna_gain = DBI_TO_MBI(ant_gain);
+	reg_rule->power_rule.max_eirp = DBM_TO_MBM(reg_pwr);
+	reg_rule->flags = reg_flags;
+}
+
+static void ath10k_reg_update_weather_radar_band(struct ath10k *ar, struct ieee80211_regdomain *regd, struct cur_reg_rule *reg_rule, u8 *rule_idx, u32 flags, u16 max_bw)
+{
+	u32 start_freq;
+	u32 end_freq;
+	u16 bw;
+	u8 i;
+
+	i = *rule_idx;
+
+	/* there might be situations when even the input rule must be dropped */
+	i--;
+
+	/* frequencies below weather radar */
+	bw = ath10k_reg_adjust_bw(reg_rule->start_freq, ETSI_WEATHER_RADAR_BAND_LOW, max_bw);
+	if (bw > 0) {
+		i++;
+
+		ath10k_reg_update_rule(regd->reg_rules + i, reg_rule->start_freq, ETSI_WEATHER_RADAR_BAND_LOW,
+				       bw, reg_rule->ant_gain, reg_rule->reg_power, flags);
+
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "\t%d. (%d - %d @ %d) (%d, %d) (%d ms) (FLAGS %d)\n",
+			   i + 1, reg_rule->start_freq, ETSI_WEATHER_RADAR_BAND_LOW, bw, reg_rule->ant_gain,
+			   reg_rule->reg_power, regd->reg_rules[i].dfs_cac_ms, flags);
+	}
+
+	/* weather radar frequencies */
+	start_freq = max_t(u32, reg_rule->start_freq, ETSI_WEATHER_RADAR_BAND_LOW);
+	end_freq = min_t(u32, reg_rule->end_freq, ETSI_WEATHER_RADAR_BAND_HIGH);
+
+	bw = ath10k_reg_adjust_bw(start_freq, end_freq, max_bw);
+	if (bw > 0) {
+		i++;
+
+		ath10k_reg_update_rule(regd->reg_rules + i, start_freq, end_freq, bw, reg_rule->ant_gain, reg_rule->reg_power, flags);
+
+		regd->reg_rules[i].dfs_cac_ms = ETSI_WEATHER_RADAR_BAND_CAC_TIMEOUT;
+
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "\t%d. (%d - %d @ %d) (%d, %d) (%d ms) (FLAGS %d)\n",
+			   i + 1, start_freq, end_freq, bw, reg_rule->ant_gain, reg_rule->reg_power,
+			   regd->reg_rules[i].dfs_cac_ms, flags);
+	}
+
+	/* frequencies above weather radar */
+	bw = ath10k_reg_adjust_bw(ETSI_WEATHER_RADAR_BAND_HIGH, reg_rule->end_freq, max_bw);
+	if (bw > 0) {
+		i++;
+
+		ath10k_reg_update_rule(regd->reg_rules + i, ETSI_WEATHER_RADAR_BAND_HIGH, reg_rule->end_freq, bw,
+				       reg_rule->ant_gain, reg_rule->reg_power, flags);
+
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "\t%d. (%d - %d @ %d) (%d, %d) (%d ms) (FLAGS %d)\n",
+			   i + 1, ETSI_WEATHER_RADAR_BAND_HIGH, reg_rule->end_freq, bw, reg_rule->ant_gain,
+			   reg_rule->reg_power, regd->reg_rules[i].dfs_cac_ms, flags);
+	}
+
+	*rule_idx = i;
+}
+
+struct ieee80211_regdomain *ath10k_reg_build_regd(struct ath10k *ar, struct cur_regulatory_info *reg_info, bool intersect)
+{
+	struct ieee80211_regdomain *tmp_regd, *default_regd, *new_regd = NULL;
+	struct cur_reg_rule *reg_rule;
+	u8 i = 0, j = 0;
+	u8 num_rules;
+	u16 max_bw;
+	u32 flags;
+
+	num_rules = reg_info->num_5ghz_reg_rules + reg_info->num_2ghz_reg_rules;
+
+	if (!num_rules)
+		return NULL;
+
+	/* Add max additional rules to accommodate weather radar band */
+	if (reg_info->dfs_region == ATH10K_DFS_REG_ETSI)
+		num_rules += 2;
+
+	tmp_regd = kzalloc(sizeof(*tmp_regd) + (num_rules * sizeof(struct ieee80211_reg_rule)), GFP_ATOMIC);
+	if (!tmp_regd)
+		return NULL;
+
+	memcpy(tmp_regd->alpha2, reg_info->alpha2, REG_ALPHA2_LEN);
+	tmp_regd->dfs_region = ath10k_map_fw_dfs_region(reg_info->dfs_region);
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Building regulatory domain: Country=%c%c DFS_region=%s rules=%d\n",
+		   reg_info->alpha2[0], reg_info->alpha2[1], ath10k_reg_get_regdom_str(tmp_regd->dfs_region),
+		   num_rules);
+
+	/* Update reg_rules[] below. Firmware is expected to
+	 * send these rules in order(2 GHz rules first and then 5 GHz)
+	 */
+	for (; i < num_rules; i++) {
+		if (reg_info->num_2ghz_reg_rules && (i < reg_info->num_2ghz_reg_rules)) {
+			reg_rule = reg_info->reg_rules_2ghz_ptr + i;
+			max_bw = min_t(u16, reg_rule->max_bw, reg_info->max_bw_2ghz);
+			flags = 0;
+		} else if (reg_info->num_5ghz_reg_rules && (j < reg_info->num_5ghz_reg_rules)) {
+			reg_rule = reg_info->reg_rules_5ghz_ptr + j++;
+			max_bw = min_t(u16, reg_rule->max_bw, reg_info->max_bw_5ghz);
+			flags = NL80211_RRF_AUTO_BW;
+		} else {
+			break;
+		}
+
+		flags |= ath10k_map_fw_reg_flags(reg_rule->flags);
+
+		ath10k_reg_update_rule(tmp_regd->reg_rules + i, reg_rule->start_freq, reg_rule->end_freq, max_bw,
+				       reg_rule->ant_gain, reg_rule->reg_power, flags);
+
+		/* Update dfs cac timeout if the dfs domain is ETSI and the
+		 * new rule covers weather radar band.
+		 * Default value of '0' corresponds to 60s timeout, so no
+		 * need to update that for other rules.
+		 */
+		if (flags & NL80211_RRF_DFS && reg_info->dfs_region == ATH10K_DFS_REG_ETSI &&
+		   (reg_rule->end_freq > ETSI_WEATHER_RADAR_BAND_LOW &&
+		    reg_rule->start_freq < ETSI_WEATHER_RADAR_BAND_HIGH)){
+			ath10k_reg_update_weather_radar_band(ar, tmp_regd, reg_rule, &i, flags, max_bw);
+			continue;
+		}
+
+		ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "\t%d. (%d - %d @ %d) (%d, %d) (%d ms) (FLAGS %d)\n",
+			   i + 1, reg_rule->start_freq, reg_rule->end_freq, max_bw, reg_rule->ant_gain,
+			   reg_rule->reg_power, tmp_regd->reg_rules[i].dfs_cac_ms, flags);
+	}
+
+	tmp_regd->n_reg_rules = i;
+
+	if (intersect) {
+
+		default_regd = ar->default_regd;
+
+		/* Get a new regd by intersecting the received regd with
+		 * our default regd.
+		 */
+		new_regd = ath10k_reg_intersect(default_regd, tmp_regd);
+		kfree(tmp_regd);
+		if (!new_regd)
+			ath10k_warn(ar, "Unable to create intersected regdomain\n");
+	} else {
+		new_regd = tmp_regd;
+	}
+
+	return new_regd;
+}
+
+/**
+ * ath10k_reg_revert_firmware_state() - Revert firmware to previous regulatory state
+ * @ar: ath10k device
+ *
+ * This function reverts the firmware regulatory state when the driver fails to
+ * process a new regulatory domain but the firmware has already accepted it.
+ * This ensures regulatory uniformity between driver and firmware.
+ *
+ * Return: 0 on success, negative error code on failure
+ */
+static int ath10k_reg_revert_firmware_state(struct ath10k *ar)
+{
+	struct cur_set_current_country_params revert_param = {};
+	u8 prev_alpha2_copy[REG_ALPHA2_LEN + 1];
+	int ret;
+
+	/* Read prev_alpha2 under lock */
+	spin_lock_bh(&ar->data_lock);
+	if (ar->prev_alpha2[0] == '\0') {
+		spin_unlock_bh(&ar->data_lock);
+		ath10k_warn(ar, "No previous country code to revert to (first boot?)\n");
+		return -EINVAL;
+	}
+	memcpy(prev_alpha2_copy, ar->prev_alpha2, sizeof(prev_alpha2_copy));
+	spin_unlock_bh(&ar->data_lock);
+
+	/* Send previous country code back to firmware */
+	memcpy(&revert_param.alpha2, prev_alpha2_copy, 2);
+	revert_param.alpha2[2] = '\0';
+
+	ret = ath10k_wmi_set_current_country_cmd(ar, &revert_param);
+	if (ret) {
+		ath10k_warn(ar, "Failed to revert country code to firmware: %d\n", ret);
+		return ret;
+	}
+
+	/* Restore driver's alpha2 to previous value under lock */
+	spin_lock_bh(&ar->data_lock);
+	memcpy(ar->alpha2, prev_alpha2_copy, sizeof(ar->alpha2));
+	spin_unlock_bh(&ar->data_lock);
+
+	/* Send SCAN_CHAN_LIST with previous regulatory domain
+	 * Note: We use the current default_regd which should still be valid
+	 * since the new regd that failed hasn't been committed yet.
+	 */
+	if (ar->state == ATH10K_STATE_ON) {
+		ret = ath10k_update_channel_list(ar, false);
+		if (ret) {
+			ath10k_warn(ar, "Failed to update channel list during revert: %d\n", ret);
+			return ret;
+		}
+	}
+
+	ath10k_warn(ar, "Reverted firmware to previous regulatory state %c%c\n",
+		    prev_alpha2_copy[0], prev_alpha2_copy[1]);
+
+	return 0;
+}
+
+void ath10k_reg_update_work(struct work_struct *work)
+{
+	struct ath10k *ar = container_of(work, struct ath10k, regd_update_work);
+	int ret;
+
+	ret = ath10k_reg_update(ar);
+	if (ret)
+		ath10k_reg_revert_firmware_state(ar); /* Attempt to revert firmware state */
+}
+
+/**
+ * ath10k_reg_fallback_work() - Work function to handle regulatory fallback
+ * @work: work structure
+ *
+ * This work function is called when the driver needs to revert firmware
+ * regulatory state. It runs in process context where it's safe to call
+ * functions that may sleep (WMI commands, mutex operations).
+ */
+void ath10k_reg_fallback_work(struct work_struct *work)
+{
+	struct ath10k *ar = container_of(work, struct ath10k, reg_fallback_work);
+
+	/* Attempt to revert firmware state */
+	ath10k_reg_revert_firmware_state(ar);
+}
+
+/**
+ * ath10k_reg_init() - Initialize self-managed regulatory for ath10k
+ * @ar: ath10k device
+ *
+ * Sets up ath10k to use self-managed regulatory mode, similar to ath11k.
+ * This allows the driver to manage its own regulatory domain without
+ * relying on the kernel's cfg80211 regulatory database.
+ */
+void ath10k_reg_init(struct ath10k *ar)
+{
+	ar->hw->wiphy->regulatory_flags = REGULATORY_WIPHY_SELF_MANAGED;
+	ar->hw->wiphy->reg_notifier = ath10k_reg_notifier_sf;
+
+	memset(ar->alpha2, 0, sizeof(ar->alpha2));
+	memset(ar->prev_alpha2, 0, sizeof(ar->prev_alpha2));
+	ar->regdom_set_by_user = false;
+
+	ath10k_dbg(ar, ATH10K_DBG_REGULATORY, "Self-managed regulatory mode initialized\n");
+}
+#endif
