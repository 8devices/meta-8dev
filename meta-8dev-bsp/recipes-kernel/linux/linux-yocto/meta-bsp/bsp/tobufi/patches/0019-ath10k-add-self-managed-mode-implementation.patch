+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+static bool ath10k_reg_is_world_alpha(char *alpha)
+{
+	if (alpha[0] == '0' && alpha[1] == '0')
+		return true;
+
+	if (alpha[0] == 'n' && alpha[1] == 'a')
+		return true;
+
+	return false;
+}
+
+int ath10k_wmi_event_reg_chan_cc_list(struct ath10k *ar, struct sk_buff *skb)
+{
+	struct cur_regulatory_info reg_info = {};
+	bool intersect = false;
+	struct ieee80211_regdomain *regd = NULL;
+	int ret;
+
+	ret = ath10k_wmi_pull_reg_chan_cc_list(ar, skb, &reg_info);
+	if (ret) {
+		ath10k_warn(ar, "failed to extract regulatory info from received event\n");
+		goto mem_free;
+	}
+
+	if (reg_info.status_code != REG_SET_CC_STATUS_PASS) {
+		/* In case of failure to set the requested ctry,
+		 * fw retains the current regd. We print a failure info
+		 * and return from here.
+		 */
+		ath10k_warn(ar, "Failed to set the requested Country regulatory setting\n");
+		goto mem_free;
+	}
+
+	/* Save current country code before processing new regulatory update
+	 * This allows us to revert firmware state if driver processing fails.
+	 * Skip during firmware restart - we want to keep the pre-crash prev_alpha2.
+	 * */
+	spin_lock_bh(&ar->data_lock);
+	if (ar->alpha2[0] != '\0' && !test_bit(ATH10K_FLAG_RESTARTING, &ar->dev_flags)) {
+		memcpy(ar->prev_alpha2, ar->alpha2, sizeof(ar->prev_alpha2));
+	}
+
+	/* Update alpha2 with the new country code from firmware */
+	memcpy(ar->alpha2, reg_info.alpha2, 2);
+	ar->alpha2[2] = '\0';
+
+	/* Avoid default reg rule updates sent during FW recovery if
+	 * it is already available
+	 */
+	if (test_bit(ATH10K_FLAG_RESTARTING, &ar->dev_flags) &&
+	    ar->default_regd) {
+		spin_unlock_bh(&ar->data_lock);
+		goto mem_free;
+	}
+	spin_unlock_bh(&ar->data_lock);
+
+	/* Avoid multiple overwrites to default regd, during core
+	 * stop-start after mac registration.
+	 */
+	if (ar->default_regd && !ar->new_regd &&
+	    !memcmp((char *)ar->default_regd->alpha2,
+		    (char *)reg_info.alpha2, 2))
+		goto mem_free;
+
+	/* Intersect new rules with default regd if a new country setting was
+	 * requested, i.e a default regd was already set during initialization
+	 * and the regd coming from this event has a valid country info.
+	 */
+	if (ar->default_regd &&
+	    !ath10k_reg_is_world_alpha((char *)
+		ar->default_regd->alpha2) &&
+	    !ath10k_reg_is_world_alpha((char *)reg_info.alpha2))
+			intersect = true;
+
+	regd = ath10k_reg_build_regd(ar, &reg_info, intersect);
+	if (!regd) {
+		ath10k_warn(ar, "failed to build regd from reg_info\n");
+		goto fallback;
+	}
+
+	spin_lock_bh(&ar->data_lock);
+
+	if (ar->default_regd) {
+		/* Already initialized - this is a dynamic update */
+		kfree(ar->new_regd);
+		ar->new_regd = regd;
+		/* Queue work to apply the new regulatory domain */
+		queue_work(ar->workqueue, &ar->regd_update_work);
+	} else {
+		/* First time - set as default_regd for initialization */
