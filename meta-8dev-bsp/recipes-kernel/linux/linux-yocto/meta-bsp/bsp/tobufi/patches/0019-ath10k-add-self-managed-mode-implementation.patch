+		struct cur_set_current_country_params set_current_param = {};
+
+		memcpy(&set_current_param.alpha2, ar->alpha2, 3);
+		ath10k_wmi_set_current_country_cmd(ar, &set_current_param);
+	}
+#else
 	if (!ath_is_world_regd(&ar->ath_common.reg_world_copy) &&
 	    !ath_is_world_regd(&ar->ath_common.regulatory)) {
 		ret = regulatory_hint(ar->hw->wiphy,
@@ -10295,7 +10348,7 @@ int ath10k_mac_register(struct ath10k *ar)
 		if (ret)
 			goto err_unregister;
 	}
-
+#endif
 	return 0;
 
