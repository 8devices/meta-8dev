index 4b11a88fbd36..eae0a3e69574 100644
--- a/drivers/net/wireless/ath/ath10k/core.h
+++ b/drivers/net/wireless/ath/ath10k/core.h
@@ -28,6 +28,11 @@
 #include "thermal.h"
 #include "wow.h"
 #include "swap.h"
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+#include "reg.h"
+
+#define ATH10K_SCAN_TIMEOUT_HZ (20 * HZ)
+#endif
 
 #define MS(_v, _f) (((_v) & _f##_MASK) >> _f##_LSB)
 #define SM(_v, _f) (((_v) << _f##_LSB) & _f##_MASK)
@@ -1304,7 +1309,24 @@ struct ath10k {
 
 	s32 tx_power_2g_limit;
 	s32 tx_power_5g_limit;
+#ifdef CONFIG_ATH10K_REG_OFFLOAD
+	/* Self-managed regulatory fields (similar to ath11k) */
+	u8 alpha2[REG_ALPHA2_LEN + 1];		  /* Current country code */
+	u8 prev_alpha2[REG_ALPHA2_LEN + 1];	  /* Previous country code for fallback */
+	bool regdom_set_by_user;  /* Track if user explicitly set country */
 
+	/* Regulatory update from firmware */
+	struct work_struct regd_update_work;
+	struct work_struct reg_fallback_work;
+
+	/* Below regd's are protected by data_lock */
+	/* This is the regd set by the firmware during initialization */
+	struct ieee80211_regdomain *default_regd;
+	/* This regd is set during dynamic country setting
+	 * This may or may not be used during the runtime
+	 */
+	struct ieee80211_regdomain *new_regd;
+#endif
 	/* must be last */
 	u8 drv_priv[] __aligned(sizeof(void *));
 };
