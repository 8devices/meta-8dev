+/**
+ * enum virt_visit - DFS state while the virtual dependency graph is resolved
+ * @VIRT_UNVISITED: not looked at yet
+ * @VIRT_ACTIVE: currently on the DFS stack; reaching it again closes a cycle
+ * @VIRT_DONE: depth resolved
+ */
+enum virt_visit {
+	VIRT_UNVISITED = 0,
+	VIRT_ACTIVE,
+	VIRT_DONE,
+};
+
+/**
+ * struct virt_zone_node - One virtual zone while the graph is being resolved
+ * @np: Device tree node of the zone
+ * @depth: Depth in the virtual dependency graph
+ * @state: DFS state
+ * @rejected: Set once the zone can never register
+ */
+struct virt_zone_node {
+	struct device_node *np;
+	int depth;
+	enum virt_visit state;
+	bool rejected;
+};
+
+/**
+ * virt_tz_same_zone() - Are two node names one zone to the thermal core?
+ * @a: A device tree node name
+ * @b: A device tree node name
+ *
+ * A zone's identity in the thermal core is tz->type, which is the name it was
+ * registered with - thermal_zone_device_register_with_trips() rejects a name of
+ * THERMAL_NAME_LENGTH characters or more outright, so tz->type is always the
+ * whole name.  thermal_zone_get_zone_by_name() then matches it case
+ * insensitively, so two names differing only in case are one zone as far as the
+ * framework is concerned.
+ *
+ * A plain strcasecmp() is safe even though virt_tz_warn_foreign_collisions()
+ * passes names this driver never collected and never length-filtered.  The
+ * bound comes from @a alone: it is always a name virt_tz_probe() collected, so
+ * it is shorter than THERMAL_NAME_LENGTH and its NUL ends the comparison within
+ * that bound whatever @b is.  A @b of THERMAL_NAME_LENGTH characters or more
+ * therefore compares as different, which is the right answer - the core rejects
+ * such a name, so that node never becomes a zone there is anything to collide
+ * with.
+ *
+ * Return: true if the core could not tell the two names apart
+ */
+static bool virt_tz_same_zone(const char *a, const char *b)
+{
+	return !strcasecmp(a, b);
+}
+
+/**
+ * virt_tz_find_zone() - Find a virtual zone by name
+ * @zones: Array of all virtual zones found in DT
+ * @nzones: Number of entries in @zones
+ * @name: Thermal zone name to look for
+ *
+ * Return: index into @zones, or -1 if @name is not one of the virtual zones
+ */
+static int virt_tz_find_zone(struct virt_zone_node *zones, int nzones,
+			     const char *name)
+{
+	int i;
+
+	for (i = 0; i < nzones; i++) {
+		/*
+		 * Resolve the edge exactly the way the core will bind it at
+		 * runtime: thermal_zone_get_zone_by_name() compares the source
+		 * string against tz->type with strncasecmp() over
+		 * THERMAL_NAME_LENGTH, and tz->type is the node name in full
+		 * because a longer one is rejected at registration.  A plain
+		 * strcmp() here would miss a virtual source the core does bind,
+		 * leaving the consumer and its source on one lockdep subclass
+		 * and reinstating the recursive locking report this subclassing
+		 * exists to avoid.
+		 */
