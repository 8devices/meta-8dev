+/**
+ * virt_tz_warn_dt_ordering() - Name the sensor zones thermal_of could not reach
+ * @dev: this driver's device, for the message
+ *
+ * A virtual zone node deliberately carries no 'thermal-sensors', and
+ * of_thermal_zone_find() does not tolerate such a child: it walks the available
+ * children of /thermal-zones looking for the zone that belongs to the sensor
+ * being registered and, on the first child that has no 'thermal-sensors', logs
+ * "missing thermal sensor" and abandons the entire search.  Every sensor whose
+ * own zone sits after that child therefore never gets a zone at all.
+ *
+ * Nothing here can prevent that - every sensor has already tried by the time
+ * this driver probes - but the core's message names the node it stopped on
+ * rather than the zones that were lost, and a sensor that has no zone at all
+ * lands on the same message, so the report points away from the real cause.
+ * Name the casualties instead.
+ */
+static void virt_tz_warn_dt_ordering(struct device *dev)
+{
+	struct device_node *np, *child, *blocker = NULL;
+
+	np = of_find_node_by_path("/thermal-zones");
+	if (!np)
+		return;
+
+	for_each_available_child_of_node(np, child) {
+		/* The test of_thermal_zone_find() gives up on */
+		if (of_count_phandle_with_args(child, "thermal-sensors",
+					       "#thermal-sensor-cells") <= 0) {
+			if (!blocker)
+				blocker = of_node_get(child);
+			continue;
+		}
+
+		if (blocker)
+			dev_err(dev,
+				"%pOFn: thermal_of stops at '%pOFn' before reaching this zone, so its sensor has no thermal zone - place every virtual zone after all sensor-backed zones\n",
+				child, blocker);
+	}
+
+	of_node_put(blocker);
+	of_node_put(np);
+}
