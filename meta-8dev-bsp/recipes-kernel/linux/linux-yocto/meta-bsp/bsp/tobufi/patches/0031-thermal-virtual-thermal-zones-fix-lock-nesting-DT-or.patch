+/**
+ * virt_tz_resolve_depth() - Depth of a virtual zone in the dependency graph
+ * @zones: Array of all virtual zones found in DT
+ * @nzones: Number of entries in @zones
+ * @idx: Index of the zone to resolve
+ *
+ * A zone whose sources are all real thermal zones has depth 0; otherwise its
+ * depth is one more than that of its deepest virtual source.  The depth both
+ * orders registration - a source is registered before the zones that use it -
+ * and becomes the lockdep subclass of the zone's tz->lock.
+ *
+ * The walk is depth-first, so a zone reached while it is still on the stack -
+ * including one that lists itself as a source - closes a cycle.  Everything is
+ * decided from the device tree, so the result does not depend on the order in
+ * which the zones happen to be registered.
+ *
+ * Return: depth of the zone, or -ELOOP if it is in a dependency cycle or has
+ *         a source that is - the code propagates to every consumer, because
+ *         none of them can work either
+ */
+static int virt_tz_resolve_depth(struct virt_zone_node *zones, int nzones, int idx)
+{
+	const char *source_name;
+	int count, i, depth = 0;
+
+	if (zones[idx].state == VIRT_DONE)
+		return zones[idx].depth;
+
+	if (zones[idx].state == VIRT_ACTIVE)
+		return -ELOOP;
+
+	zones[idx].state = VIRT_ACTIVE;
+
+	count = of_property_count_strings(zones[idx].np, "source-thermal-zones");
+
+	for (i = 0; i < count; i++) {
+		int src, src_depth;
+
+		if (of_property_read_string_index(zones[idx].np,
+						  "source-thermal-zones",
+						  i, &source_name))
+			continue;
+
+		src = virt_tz_find_zone(zones, nzones, source_name);
+		if (src < 0)
+			continue;	/* real zone: contributes depth 0 */
+
+		src_depth = virt_tz_resolve_depth(zones, nzones, src);
+		if (src_depth < 0) {
+			depth = src_depth;
+			break;
+		}
+
+		depth = max(depth, src_depth + 1);
+	}
+
+	zones[idx].state = VIRT_DONE;
+	zones[idx].depth = depth;
+
+	return depth;
+}
