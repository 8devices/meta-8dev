+ */
+static bool virt_tz_source_failed(struct virt_zone_node *zones, int nzones,
+				  int idx, const char **name)
+{
+	const char *source_name;
+	int count, i, src;
+
+	count = of_property_count_strings(zones[idx].np, "source-thermal-zones");
+
+	for (i = 0; i < count; i++) {
+		if (of_property_read_string_index(zones[idx].np,
+						  "source-thermal-zones",
+						  i, &source_name))
+			continue;
+
+		src = virt_tz_find_zone(zones, nzones, source_name);
+		if (src >= 0 && zones[src].rejected) {
+			*name = source_name;
+			return true;
+		}
+	}
