---
 drivers/thermal/virtual-thermal-zones.c | 2909 +++++++++++++++++++----
 1 file changed, 2401 insertions(+), 508 deletions(-)

diff --git a/drivers/thermal/virtual-thermal-zones.c b/drivers/thermal/virtual-thermal-zones.c
index b3a84d3d576c..b2817ada6473 100644
--- a/drivers/thermal/virtual-thermal-zones.c
+++ b/drivers/thermal/virtual-thermal-zones.c
@@ -12,15 +12,56 @@
  * This driver registers virtual thermal zones from device tree nodes with
  * compatible = "virtual-thermal-zone". Virtual zones aggregate
  * temperatures from multiple source thermal zones using configurable calculation methods.
+ *
+ *
+ * IMPORTANT - where virtual zone nodes may be placed in the device tree
+ *
+ *   Put every virtual zone node AFTER all sensor-backed zones under
+ *   /thermal-zones.  A sensor whose zone appears after a virtual zone in device
+ *   tree order does not get registered at all - its real thermal zone silently
+ *   fails to appear, and nothing in this driver can prevent that.
+ *
+ * Why: a virtual zone node deliberately has no 'thermal-sensors' property, and
+ * thermal_of does not tolerate such a child.  of_thermal_zone_find() walks every
+ * available child of /thermal-zones looking for the zone belonging to the sensor
+ * being registered, and on the first child without 'thermal-sensors' it does
+ *
+ *	pr_err("%pOFn: missing thermal sensor\n", child);
+ *	tz = ERR_PTR(-EINVAL);
+ *	goto out;
+ *
+ * - it abandons the entire search rather than skipping the node.  Every sensor
+ * whose own zone had not been reached yet loses its zone.
+ *
+ * Adding the nodes with &{/thermal-zones} { ... }, which is how a board normally
+ * does it, appends them and is therefore safe.  Declaring a virtual zone ahead
+ * of the SoC's own zones - for instance in a .dtsi included before the SoC one,
+ * or by deleting and re-adding a zone - is not.
+ *
+ * A related, harmless but misleading effect: a sensor that has no zone at all
+ * runs its search off the end of the list and logs that message against the
+ * first virtual zone it reaches, which had nothing to do with it.
+ *
+ * This is a thermal_of limitation, not something this driver can guard against -
+ * by the time thermal_of walks the list the nodes are already in it.  The proper
+ * fix is to make of_thermal_zone_find() skip such a child instead of failing,
+ * which changes behaviour for every device tree thermal zone on the platform and
+ * so is a deliberate decision, not a side effect of this driver.
  */
 
 #define pr_fmt(fmt) KBUILD_MODNAME ": " fmt
 
 #include <linux/err.h>
 #include <linux/init.h>
+#include <linux/jiffies.h>
+#include <linux/lockdep.h>
+#include <linux/math64.h>
+#include <linux/minmax.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/of.h>
+#include <linux/of_platform.h>
+#include <linux/overflow.h>
 #include <linux/platform_device.h>
 #include <linux/slab.h>
 #include <linux/sort.h>
@@ -28,6 +69,15 @@
 
 /**
  * enum temp_calc_logic - Temperature calculation method types
+ * @LOGIC_NONE: Single source - report its temperature unchanged
+ * @LOGIC_MAX: Highest of the source temperatures; the default for several
+ * @LOGIC_MIN: Lowest of the source temperatures
+ * @LOGIC_AVERAGE: Arithmetic mean of the source temperatures
+ * @LOGIC_MEDIAN: Middle value once sorted, or the mean of the middle two
+ * @LOGIC_MEAN: Alias of @LOGIC_AVERAGE
+ * @LOGIC_WEIGHTED_AVERAGE: Mean weighted by 'source-weights'
+ * @LOGIC_ROLLING_AVERAGE: Boxcar average over evenly spaced samples
+ * @LOGIC_EXPONENTIAL_AVERAGE: Exponential moving average with a time constant
  */
 enum temp_calc_logic {
 	LOGIC_NONE = 0,
@@ -57,257 +107,167 @@ static const char * const logic_names[] = {
 #define MAX_VIRTUAL_ZONES 32
 #define ROLLING_AVG_WINDOW_SIZE 5
 
+/*
+ * Start the rolling window again rather than pushing into it when the gap
+ * between two accepted samples exceeds this many window spans.
+ *
+ * It has to be a multiple, not one span, because the gap is measured from the
+ * last sample this filter accepted, which between pushes is simply how often
+ * the zone is read.  'sample-interval-ms' is a floor on that, not the rate, so
+ * a zone polled more slowly than one window span would otherwise reset on every
+ * single read and never hold more than one sample - a boxcar average that had
+ * quietly become a pass-through.  Eight spans mirrors EMA_RESEED_TAUS, which is
+ * eight times the exponential average's own memory length.
+ *
+ * This narrows that case rather than removing it: a zone read less often than
+ * eight window spans still resets on every read.  That needs a tree asking for
+ * a window shorter than the rate it is read at, which contradicts itself, and
+ * closing it properly means remembering the gap actually observed rather than
+ * the configured floor - more state than the mode is worth.
+ */
+#define ROLLING_RESEED_WINDOWS 8
+
+/*
+ * Maximum depth of virtual-on-virtual chaining.
+ *
+ * A virtual zone's ->get_temp() reads its source zones, so a source zone's
+ * tz->lock is acquired nested inside this zone's tz->lock.  Every zone the
+ * thermal core creates shares a single lock class, which lockdep reports as
+ * recursive locking, so virt_tz_register() re-keys each virtual zone's
+ * tz->lock with a class of its own and a subclass equal to the zone's depth
+ * in the virtual dependency graph.  Dependency edges always run from a higher
+ * depth to a lower one, so the resulting class graph is acyclic by
+ * construction.  The usable depth is capped by MAX_LOCKDEP_SUBCLASSES.
+ */
+#define MAX_VIRT_DEPTH ((int)MAX_LOCKDEP_SUBCLASSES - 1)
+
+/* Bounds and default for 'time-constant-ms' (exponential-average), in ms */
+#define EMA_TAU_MS_MIN 10
+#define EMA_TAU_MS_MAX 600000
+#define EMA_TAU_MS_DEFAULT 3000
+
+/*
+ * Reseed the exponential average rather than integrating when the gap between
+ * two reads exceeds this many time constants: the previous value carries no
+ * useful information any more, and it keeps the arithmetic bounded.
+ */
+#define EMA_RESEED_TAUS 8
+
+/*
+ * Upper bound on a single entry of 'source-weights'.  Keeps the weighted sum
+ * inside an s64 for any plausible number of sources and temperature.
+ */
+#define MAX_SOURCE_WEIGHT 65535
+
+/*
+ * Bounds on 'coefficients'.  Same reasoning as MAX_SOURCE_WEIGHT: reject a
+ * configuration that can only be a mistake.  The corrected temperature is
+ * computed in s64 and clamped on top of this, so an in-range coefficient can
+ * never overflow the int the thermal core stores.
+ */
+#define MAX_COEFF_SLOPE 65535
+#define MAX_COEFF_OFFSET 1000000	/* 1000 degrees C, in millidegrees */
+
+/* Bounds for 'sample-interval-ms' (rolling-average), in ms */
+#define SAMPLE_MS_MIN 10
+#define SAMPLE_MS_MAX 600000
+
+/*
+ * The thermal core refuses a zone with more trips than fit the int trip mask
+ * it is handed (see thermal_zone_device_register_with_trips()), so reject them
+ * here with a message that names the limit that actually applies.
+ */
+#define MAX_TRIPS 31
+
 /**
  * struct virt_tz - Runtime data for virtual thermal zone
- * @tz: Array of source thermal zone device pointers
+ * @tz: Array of source thermal zone device pointers. These are NOT
+ *      reference counted; their lifetime is covered by the device links
+ *      that virt_tz_link_sources() adds - see the comment there
  * @num_sensors: Number of source thermal zones
  * @logic: Temperature calculation method
- * @lock: Mutex for protecting concurrent access
+ * @depth: Depth in the virtual dependency graph (0 = every source is real)
  * @of_node: Cached device tree node pointer
+ * @weights: Per-source weights for LOGIC_WEIGHTED_AVERAGE, NULL if equal
+ * @temps: Scratch array holding the temperatures read this pass
+ * @wbuf: Scratch array holding the weight matching each entry of @temps
+ * @sorted: Scratch array used to sort @temps for LOGIC_MEDIAN
+ * @tau_ms: Time constant of the exponential average, in ms
+ * @sample_interval_ms: Minimum spacing between rolling-average samples, in ms
+ * @last_sample: jiffies at which the filter state was last advanced
+ * @trend: Direction of the last accepted sample.  Written by
+ *	virt_tz_apply_filter(), and by virt_tz_read_temp() when no source can
+ *	be read at all; read by virt_tz_get_trend().  All three run under
+ *	tz->lock
+ * @last_output: Last value published by a stateful calculation method
+ * @last_output_valid: Whether @last_output holds a value
  * @rolling_temps: Circular buffer for rolling average
  * @rolling_index: Current index in rolling buffer
  * @rolling_count: Number of valid entries in rolling buffer
  * @exp_avg_temp: Last exponential average temperature
- * @exp_avg_initialized: Whether exponential average is initialized
+ * @read_failures: Consecutive reads in which no source could be read
+ *
+ * Locking: everything from @tz to @sample_interval_ms is configuration, written
+ * by virt_tz_register() before the zone is registered and read-only from then
+ * on.  That is what makes the lock-free reads elsewhere safe - virt_tz_bind()
+ * and virt_tz_unbind() take @of_node, the probe summary takes @num_sensors,
+ * @logic and @depth - and what lets virt_tz_unregister() free it all once the
+ * zone is gone and no reader is left.
+ *
+ * Everything from @last_sample down, together with the contents of the @temps,
+ * @wbuf and @sorted scratch arrays, is mutated only by virt_tz_read_temp(),
+ * which the thermal core always calls with tz->lock held (see
+ * __thermal_zone_get_temp()).  That serialises the readers of one zone, so none
+ * of it needs a lock of its own.
  */
 struct virt_tz {
 	struct thermal_zone_device **tz;
 	int num_sensors;
 	enum temp_calc_logic logic;
-	struct mutex lock;
+	int depth;
 	struct device_node *of_node;
+	/* Weighted average configuration */
+	u32 *weights;
+	/* Read-path scratch, sized num_sensors */
+	int *temps;
+	int *wbuf;
+	int *sorted;
+	/* Time base for the stateful calculation methods */
+	u32 tau_ms;
+	u32 sample_interval_ms;
+	unsigned long last_sample;
+	int last_output;
+	enum thermal_trend trend;
+	bool last_output_valid;
 	/* Rolling average state */
 	int rolling_temps[ROLLING_AVG_WINDOW_SIZE];
 	int rolling_index;
 	int rolling_count;
 	/* Exponential average state */
 	int exp_avg_temp;
-	bool exp_avg_initialized;
+	/* Consecutive reads in which no source could be read */
+	unsigned int read_failures;
 };
 
 /**
- * struct zone_defer_entry - Track defer count for each zone
- * @name: Allocated copy of zone name from device tree
- * @defer_count: Number of times this zone caused a defer
- * @permanent_fail: True if zone has permanent error (invalid sources)
- */
-struct zone_defer_entry {
-	char *name;
-	int defer_count;
-	bool permanent_fail;
-};
-
-#define MAX_DEFER_COUNT 2
-
-/* Global defer tracking - persists across probe attempts
- * Note: These are static globals because kernel clears platform_drvdata on probe failure
- */
-static struct zone_defer_entry global_defer_list[MAX_VIRTUAL_ZONES];
-static int global_defer_list_count;
-
-/* Global registered zones tracking - persists across probe attempts
- * Stores successfully registered zones so we don't re-register them on defer
- */
-static struct thermal_zone_device *global_registered_zones[MAX_VIRTUAL_ZONES];
-static int global_registered_count;
-
-/**
- * cleanup_global_defer_list() - Clean up all allocated zone name strings in global defer list
- */
-static void cleanup_global_defer_list(void)
-{
-	int i;
-
-	for (i = 0; i < global_defer_list_count; i++) {
-		kfree(global_defer_list[i].name);
-		global_defer_list[i].name = NULL;
-	}
-	global_defer_list_count = 0;
-}
-
-/**
- * get_zone_defer_count() - Get defer count for a zone
- * @zone_name: Name of the zone to look up
- *
- * Return: defer count for the zone, or 0 if not found
- */
-static int get_zone_defer_count(const char *zone_name)
-{
-	int i;
-
-	if (!zone_name)
-		return 0;
-
-	for (i = 0; i < global_defer_list_count; i++) {
-		if (!strcmp(global_defer_list[i].name, zone_name))
-			return global_defer_list[i].defer_count;
-	}
-
-	return 0;
-}
-
-/**
- * increment_zone_defer_count() - Increment defer count for a zone
- * @zone_name: Name of the zone to increment
- */
-static void increment_zone_defer_count(const char *zone_name)
-{
-	int i;
-	char *name_copy;
-
-	if (!zone_name)
-		return;
-
-	/* Check if zone already exists in list */
-	for (i = 0; i < global_defer_list_count; i++) {
-		if (!strcmp(global_defer_list[i].name, zone_name)) {
-			global_defer_list[i].defer_count++;
-			return;
-		}
-	}
-
-	/* Add new entry if space available */
-	if (global_defer_list_count < MAX_VIRTUAL_ZONES) {
-		/* Allocate and copy zone name */
-		name_copy = kstrdup(zone_name, GFP_KERNEL);
-		if (!name_copy) {
-			/* CRITICAL: Cannot track defer without memory - use BUG_ON to halt */
-			pr_crit("CRITICAL: Failed to allocate memory for zone name '%s'\n", zone_name);
-			BUG();
-		}
-
-		global_defer_list[global_defer_list_count].name = name_copy;
-		global_defer_list[global_defer_list_count].defer_count = 1;
-		global_defer_list[global_defer_list_count].permanent_fail = false;
-		global_defer_list_count++;
-	} else {
-		pr_warn("defer_list full (%d entries), cannot track defer for zone '%s'\n", MAX_VIRTUAL_ZONES, zone_name);
-	}
-}
-
-/**
- * mark_zone_permanent_fail() - Mark a zone as permanently failed
- * @zone_name: Name of the zone to mark
- */
-static void mark_zone_permanent_fail(const char *zone_name)
-{
-	int i;
-	char *name_copy;
-
-	if (!zone_name)
-		return;
-
-	/* Check if zone already exists in list */
-	for (i = 0; i < global_defer_list_count; i++) {
-		if (!strcmp(global_defer_list[i].name, zone_name)) {
-			global_defer_list[i].permanent_fail = true;
-			return;
-		}
-	}
-
-	/* Add new entry if space available */
-	if (global_defer_list_count < MAX_VIRTUAL_ZONES) {
-		/* Allocate and copy zone name */
-		name_copy = kstrdup(zone_name, GFP_KERNEL);
-		if (!name_copy) {
-			/* CRITICAL: Cannot track permanent fail without memory - use BUG_ON to halt */
-			pr_crit("CRITICAL: Failed to allocate memory for zone name '%s'\n", zone_name);
-			BUG();
-		}
-
-		global_defer_list[global_defer_list_count].name = name_copy;
-		global_defer_list[global_defer_list_count].defer_count = 0;
-		global_defer_list[global_defer_list_count].permanent_fail = true;
-		global_defer_list_count++;
-	} else {
-		pr_warn("defer_list full (%d entries), cannot track permanent fail for zone '%s'\n", MAX_VIRTUAL_ZONES, zone_name);
-	}
-}
-
-/**
- * is_zone_permanent_fail() - Check if a zone is marked as permanently failed
- * @zone_name: Name of the zone to check
+ * struct virt_tz_data - Every zone registered by one successful probe
+ * @nzones: Number of entries in @zone
+ * @zone: The registered zones, in the order they were registered
  *
- * Return: true if zone is permanently failed, false otherwise
- */
-static bool is_zone_permanent_fail(const char *zone_name)
-{
-	int i;
-
-	if (!zone_name)
-		return false;
-
-	for (i = 0; i < global_defer_list_count; i++) {
-		if (!strcmp(global_defer_list[i].name, zone_name))
-			return global_defer_list[i].permanent_fail;
-	}
-
-	return false;
-}
-
-/**
- * has_deferred_zones() - Check if there are zones that might still be deferred
- *
- * Return: true if there are zones with defer count > 0 and not permanently failed
- */
-static bool has_deferred_zones(void)
-{
-	int i;
-
-	for (i = 0; i < global_defer_list_count; i++) {
-		/* If zone has defer attempts and is not permanently failed,
-		 * it might be deferred again in future probe attempts
-		 */
-		if (global_defer_list[i].defer_count > 0 &&
-		    !global_defer_list[i].permanent_fail)
-			return true;
-	}
-
-	return false;
-}
-
-/**
- * zone_permanent_fail_count() - Count zones marked as permanently failed
- *
- * Return: Number of zones marked with permanent_fail = true
- */
-static int zone_permanent_fail_count(void)
-{
-	int i, count = 0;
-
-	for (i = 0; i < global_defer_list_count; i++) {
-		if (global_defer_list[i].permanent_fail)
-			count++;
-	}
-
-	return count;
-}
-
-/**
- * is_zone_already_registered() - Check if a zone is already registered
- * @zone_name: Name of the zone to check
- *
- * Return: true if zone is already registered, false otherwise
- */
-static bool is_zone_already_registered(const char *zone_name)
-{
-	int i;
-
-	if (!zone_name)
-		return false;
-
-	for (i = 0; i < global_registered_count; i++) {
-		if (global_registered_zones[i] &&
-		    global_registered_zones[i]->type &&
-		    !strcmp(global_registered_zones[i]->type, zone_name))
-			return true;
-	}
-
-	return false;
-}
+ * A probe either registers every zone it can and stores them here, or it
+ * registers nothing: a zone that defers rolls the whole attempt back.  Nothing
+ * therefore has to survive a failed probe, and the teardown in virt_tz_remove()
+ * is just this array walked backwards.
+ */
+struct virt_tz_data {
+	int nzones;
+	struct thermal_zone_device *zone[];
+};
 
 /**
  * compare_ints() - Comparison function for sorting
+ * @a: First value
+ * @b: Second value
  */
 static int compare_ints(const void *a, const void *b)
 {
@@ -323,6 +283,8 @@ static int compare_ints(const void *a, const void *b)
 
