// SPDX-License-Identifier: BSD-3-Clause

/dts-v1/;

#include "qcs6490-citron.dtsi"
#include <dt-bindings/leds/common.h>

/ {
	model = "8devices Robonode Vision";
	compatible = "8devices,robovision", "8devices,citron",
		"qcom,qcm6490";

	qcom,msm-id = <497 0x10000>, <498 0x10000>, <475 0x10000>, <515 0x10000>;

	/*
	 * Cell 0 is <unused:8 major:8 minor:8 platform_type:8>, cell 1 is
	 * <ddr_class:3 subtype:8> at bits 10:8 and 7:0. The subtype lives in
	 * cell 1 only; the legacy form that packed it into cell 0's top byte
	 * is not used here.
	 *
	 * The DDR class is not optional. UEFI's DTB selector compares it for
	 * equality alongside chip-id, platform and subtype, and this SoM reports
	 * class 6, so cell 1 must be 0x6xx. Leaving it out makes every DTB in
	 * combined-dtb.dtb fail to match; UEFI then falls back to its built-in
	 * RB3gen2 tree, which has no eMMC node, and the rootfs never appears.
	 * Boards that ship different DRAM need a different value here.
	 *
	 * Values must agree with the CDT flashed by edl_flash.py -b.
	 */
	qcom,board-id = <0x00010020 0x642>;

	/*
	 * RGB status LED, 3 gpio-leds channels. Common-anode LED (Wurth 155124M173200)
	 * with cathodes low-side switched by DMG1012T N-FETs, so channels are active-HIGH.
	 */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&rgb_led_state>;

		led-red {
			gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};

		led-green {
			gpios = <&tlmm 84 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};

		led-blue {
			gpios = <&tlmm 125 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};
	};
};

&tlmm {
	rgb_led_state: rgb-led-state {
		pins = "gpio117", "gpio84", "gpio125";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

/*
 * USB roles are FIXED on this carrier, not OTG: there is no usable USB_ID/CC path
 * to the SoC, so role detection can't work. Each port is pinned to one role.
 * USB0 = device (matches the bootrom/bootloader EDL+fastboot device-mode path,
 * +5V held off), USB1 = host (+5V always on). VBUS load switches are driven by
 * fixed GPIO levels: GPIO52 USB0_PWR_SW low, GPIO53 USB1_PWR_SW high.
 */

/* USB0 = SoC usb_1 (a600000): fixed device/gadget. +5V source held off, no ID. */
&usb_1 {
	dr_mode = "peripheral";
};

/*
 * No Type-C mux / pmic-glink on this carrier and the SS lanes arrive at a fixed
 * orientation, so delete the orientation-switch left at the sc7280 default.
 */
&usb_1_qmpphy {
	/delete-property/ orientation-switch;
};

/*
 * USB1 = SoC usb_2 (8c00000): fixed HOST, HS PHY only (USB 2.0). +5V is always on
 * via usb1_vbus below. Enable the controller + HS PHY (disabled by default in
 * sc7280). Drop the default usb-role-switch (targets the disabled EUD debugger);
 * its port node stays since eud_ep references it by phandle.
 */
&usb_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	status = "okay";
};

&usb_2_hsphy {
	vdda-pll-supply = <&vreg_l10c_0p88>;
	vdda18-supply = <&vreg_l1c_1p8>;
	vdda33-supply = <&vreg_l2b_3p072>;
	status = "okay";
};

/*
 * USB VBUS PWR_EN pins for the UCS2113 load switch, held at fixed levels via the
 * regulators below: GPIO52 (USB0) low => 5V off (usb0_vbus left unenabled),
 * GPIO53 (USB1) high => 5V on (usb1_vbus always-on).
 */
&tlmm {
	/* GPIO52 = USB0_PWR_SW (held low / 5V off). */
	usb0_vbus_en_state: usb0-vbus-en-state {
		pins = "gpio52";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* GPIO53 = USB1_PWR_SW (held high / 5V on). */
	usb1_vbus_en_state: usb1-vbus-en-state {
		pins = "gpio53";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

/ {
	usb0_vbus: regulator-usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB0_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&tlmm 52 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_vbus_en_state>;
	};

	usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB1_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&tlmm 53 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&usb1_vbus_en_state>;
	};
};

/*
 * On-carrier I2C EEPROM: ST M24256E-FMC6TG (32 KB) on i2c11 (GPIO44 SDA, GPIO45
 * SCL; pinmux from sc7280). GPIO46 = WC write-protect via the at24 wp-gpios.
 * Main 32 KB array at 0x50; the "-F" 64-byte write-lockable page at 0x58 is not
 * instantiated.
 */

/*
 * QUP wrapper 1 hosts i2c11 (EEPROM) and uart10/uart12; disabled by default in
 * sc7280, enable it or the OF core won't instantiate its children.
 * firmware-name is required: the GENI driver loads per-SE firmware from the
 * wrapper node for any SE the bootloader left unprogrammed (all of QUP1). Without
 * it i2c11/uart10/uart12 fail to probe (-EINVAL).
 */
&qupv3_id_1 {
	firmware-name = "qcom/qcs6490/qupv3fw.elf";
	status = "okay";
};

&i2c11 {
	clock-frequency = <400000>;
	status = "okay";

	/* Main array @0x50; powered from +1V8_VREG_L8C; WC=gpio46 write-protects (at24 wp-gpios). */
	eeprom@50 {
		compatible = "atmel,24c256";
		reg = <0x50>;
		pagesize = <64>;
		vcc-supply = <&vreg_l8c_1p62>;
		wp-gpios = <&tlmm 46 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&eeprom_wc_state>;
	};
};

&tlmm {
	/* GPIO46 = EEPROM WC: GPIO output, used as the at24 write-protect line. */
	eeprom_wc_state: eeprom-wc-state {
		pins = "gpio46";
		function = "gpio";
		bias-disable;
	};
};

/*
 * Five extra 4-wire GENI UARTs (CTS/RFR/TX/RX) exposed on the carrier; pinmux is
 * in sc7280, the nodes just default to disabled. uart1/3/4 are on QUP0 (enabled
 * by default), uart10/uart12 on QUP1 (enabled above). Pin map (CTS, RFR, TX, RX):
 *   uart1  (QUP0 SE1) : gpio4-7
 *   uart3  (QUP0 SE3) : gpio12-15
 *   uart4  (QUP0 SE4) : gpio16-19
 *   uart10 (QUP1 SE2) : gpio40-43
 *   uart12 (QUP1 SE4) : gpio48-51
 */
&uart1 {
	status = "okay";
};

&uart3 {
	status = "okay";
};

&uart4 {
	status = "okay";
};

&uart10 {
	status = "okay";
};

/*
 * uart12 uses GPIO48-51, freed from gpio-reserved-ranges in the SOM dtsi. This
 * REQUIRES the matching XBL/TZ release of those pins; without it the board hangs
 * at gpiochip bringup (see the note in qcs6490-citron.dtsi).
 */
&uart12 {
	status = "okay";
};

/*
 * PCIe1 (dual-lane) -> on-carrier QCN9274 Wi-Fi (ath12k). pcie1_phy + supplies
 * are enabled in the SOM dtsi; enable the controller and wire its board signals
 * (GPIO79 CLKREQ, GPIO80 WAKE, GPIO81 PERST). The QCN9274 needs no endpoint node.
 * No regulator/clock node: its rails are hardware-sequenced off +5V0 and the
 * refclk is the SoC's internal PCIE1_REFCLK, so only PERST/WAKE/CLKREQ are wired.
 */
&tlmm {
	pcie1_reset_n: pcie1-reset-n-state {
		pins = "gpio81";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-disable;
	};

	pcie1_wake_n: pcie1-wake-n-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&pcie1 {
	perst-gpios = <&tlmm 81 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_reset_n>, <&pcie1_wake_n>, <&pcie1_clkreq_n>;
	status = "okay";
};

/*
 * PCIe0 (single lane) -> on-carrier PI7C9X2G304EV PCIe switch.
 *
 * Topology: SoC RC --(PCIe0 x1)--> PI7C9X2G304EV upstream port (port 0)
 *                                    |-- downstream port 1 --> RTL8111K Ethernet
 *                                    `-- downstream port 2 --> RTL8111K Ethernet
 *
 * pcie0_phy + supplies are enabled in the SOM dtsi; enable the controller and
 * wire only the upstream signals the SoC drives: PERST (GPIO86) and CLKREQ
 * (GPIO88). iommu-map is overridden below for the switch topology. The switch and
 * both NICs auto-enumerate (r8169 -> two net interfaces), no child nodes needed.
 * WAKE is not wired: the downstream WAKE# nets are per-NIC PME signals, not the
 * upstream link wake, and aren't needed for enumeration.
 */
&tlmm {
	pcie0_reset_n: pcie0-reset-n-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-disable;
	};
};

&pcie0 {
	perst-gpios = <&tlmm 86 GPIO_ACTIVE_LOW>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie0_reset_n>, <&pcie0_clkreq_n>;

	/*
	 * IOMMU stream-ID map for the PI7C9X2G304 switch topology.
	 *
	 * The stock sc7280 map assumes one endpoint, so the two RTL8111K NICs
	 * behind the switch get the fallback SID 0x1c00 with no domain -> arm-smmu
	 * "Format=2 TF" faults, AER storm, dead/unstable eth. Per-device SIDs don't
	 * work either: assigning 0x1c02 makes qcom_smmu_write_s2cr() take a sync
	 * external abort at attach (secure-world/hyp rejecting the stream).
	 *
	 * The switch has no ACS, so Linux puts every pcie0 device in one iommu
	 * group anyway. Collapse all RIDs onto the known-good 0x1c00 with
	 * iommu-map-mask = <0x0> - one SME/S2CR reused for all, no 0x1c02 abort.
	 * Confirmed on hardware: removes both the s2cr abort and the TF faults. (A
	 * separate pre-existing AER RxErr/UnsupReq storm remains, unrelated to the
	 * IOMMU.)
	 */
	iommu-map = <0x0 &apps_smmu 0x1c00 0x1>;
	iommu-map-mask = <0x0>;

	status = "okay";
};

/*
 * Sony IMX577 on CSI0: CSIPHY0 (CAMSS port@0), I2C on CCI0 bus 0 at 0x1a, driven
 * by the imx412 driver ("sony,imx577" shared match). camcc + CAMSS are disabled
 * on the SOM (qcs6490-citron.dtsi), so re-enable them here for the carrier.
 */
&camcc {
	status = "okay";
};

&camss {
	vdda-phy-supply = <&vreg_l10c_0p88>;
	vdda-pll-supply = <&vreg_l6b_1p2>;

	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;

			csiphy0_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0 1 2 3>;
				remote-endpoint = <&imx577_ep>;
			};
		};
	};
};

/* CCI0 hosts both sensors: bus 0 -> IMX577, bus 1 -> OV9282. */
&cci0 {
	pinctrl-0 = <&cci0_default &cci1_default>;
	pinctrl-1 = <&cci0_sleep &cci1_sleep>;
	status = "okay";
};

&cci0_i2c0 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera@1a {
		compatible = "sony,imx577";
		reg = <0x1a>;

		reset-gpios = <&tlmm 113 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default", "suspend";
		pinctrl-0 = <&cam0_default>;
		pinctrl-1 = <&cam0_suspend>;

		clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK0_CLK>;
		assigned-clock-rates = <24000000>;

		/* Module self-regulates; all imx412 supplies map to the single 1.8V rail. */
		dovdd-supply = <&vreg_l19b_1p8>;
		avdd-supply = <&vreg_l19b_1p8>;
		dvdd-supply = <&vreg_l19b_1p8>;

		port {
			imx577_ep: endpoint {
				link-frequencies = /bits/ 64 <600000000>;
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&csiphy0_ep>;
			};
		};
	};
};

&tlmm {
	cam0_default: cam0-default-state {
		mclk-pins {
			pins = "gpio64";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};

		rst-pins {
			pins = "gpio113";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	cam0_suspend: cam0-suspend-state {
		mclk-pins {
			pins = "gpio64";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-pull-down;
		};

		rst-pins {
			pins = "gpio113";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	/* imx412 has no standby control; hold CAM0_STBY/PDN de-asserted (active-low, drive high). */
	cam0_pwdn_hog: cam0-pwdn-hog {
		gpio-hog;
		gpios = <112 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "CAM0_STBY_N";
	};
};

/*
 * OmniVision OV9282 (1 MP mono global shutter) on CSI1: CSIPHY1 (CAMSS port@1),
 * I2C on CCI0 bus 1 at 0x60, mainline ov9282 driver (2 lanes, 400 MHz link).
 * camcc/CAMSS already enabled above; this only adds the CSIPHY1 port.
 */
&camss {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			csiphy1_ep: endpoint {
				clock-lanes = <7>;
				data-lanes = <0 1>;
				remote-endpoint = <&ov9282_ep>;
			};
		};
	};
};

&cci0_i2c1 {
	#address-cells = <1>;
	#size-cells = <0>;

	camera@60 {
		compatible = "ovti,ov9282";
		reg = <0x60>;

		/* ov9282 drives XCLR high to release reset (inverse of most drivers). */
		reset-gpios = <&tlmm 11 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default", "suspend";
		pinctrl-0 = <&cam1_default>;
		pinctrl-1 = <&cam1_suspend>;

		clocks = <&camcc CAM_CC_MCLK1_CLK>;
		assigned-clocks = <&camcc CAM_CC_MCLK1_CLK>;
		assigned-clock-rates = <24000000>;

		/* Module self-regulates; all ov9282 supplies map to the single 1.8V rail (L8C). */
		avdd-supply = <&vreg_l8c_1p62>;
		dovdd-supply = <&vreg_l8c_1p62>;
		dvdd-supply = <&vreg_l8c_1p62>;

		port {
			ov9282_ep: endpoint {
				link-frequencies = /bits/ 64 <400000000>;
				data-lanes = <1 2>;
				remote-endpoint = <&csiphy1_ep>;
			};
		};
	};
};

&tlmm {
	cam1_default: cam1-default-state {
		mclk-pins {
			pins = "gpio65";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-disable;
		};

		rst-pins {
			pins = "gpio11";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	cam1_suspend: cam1-suspend-state {
		mclk-pins {
			pins = "gpio65";
			function = "cam_mclk";
			drive-strength = <2>;
			bias-pull-down;
		};

		rst-pins {
			pins = "gpio11";
			function = "gpio";
			drive-strength = <2>;
			bias-disable;
		};
	};

	/* ov9282 has no standby control; hold CAM1_STBY/PDN de-asserted (active-low, drive high). */
	cam1_pwdn_hog: cam1-pwdn-hog {
		gpio-hog;
		gpios = <27 GPIO_ACTIVE_HIGH>;
		output-high;
		line-name = "CAM1_STBY_N";
	};
};

/* ov9282 enables supplies without setting a voltage; pin L8C to 1.8V (else idles at 1.62V floor). */
&vreg_l8c_1p62 {
	regulator-min-microvolt = <1800000>;
	regulator-max-microvolt = <1800000>;
};

/*
 * Venus HW video codec. videocc is disabled on the SOM (qcs6490-citron.dtsi) and
 * the codec is disabled by default in sc7280.dtsi; re-enable both here.
 */
&videocc {
	status = "okay";
};

/*
 * DISP0 (MIPI-DSI0) -> Waveshare 23448, an 8" 1280x800 IPS DSI panel ("8inch DSI
 * LCD (C)", the Raspberry Pi form factor). Connector pins: SDA/SCL=gpio56/57 (i2c14)
 * RST=61 BL_EN=39 STBY/PDN=96 START=38 ADP_PRESENT=105 RDY/INT=36 BL_PWM=pm8350c
 * gpio8; interface supply +1V8_VREG_L18B=vreg_l18b_1p8.
 *
 * The panel ships with an adapter board that is a DSI-to-DPI bridge on the
 * connector's I2C bus. It sequences the panel and dims the backlight over I2C
 * registers, so none of the DISP0 control pins are needed to drive the panel: only
 * RST (active low) and BL_EN are held de-asserted/on, for adapters that pass them
 * through, and the rest stay documented-but-unconsumed pin states.
 *
 * The panel runs on two of the four DSI0 data lanes.
 */
&dispcc {
	status = "okay";
};

&mdss {
	status = "okay";
};

&mdss_dsi {
	vdda-supply = <&vreg_l6b_1p2>;
	status = "okay";
};

&mdss_dsi_phy {
	vdds-supply = <&vreg_l10c_0p88>;
	status = "okay";
};

&mdss_dsi0_out {
	remote-endpoint = <&ws_bridge_in>;
	data-lanes = <0 1>;
};

&i2c14 {
	clock-frequency = <400000>;
	status = "okay";

	/*
	 * power-supply is the connector's +1V8 interface rail: the panel's own +5V is
	 * unswitched on the carrier, and the driver never touches the supply, but the
	 * binding requires one.
	 */
	bridge@45 {
		compatible = "waveshare,dsi2dpi";
		reg = <0x45>;
		power-supply = <&vreg_l18b_1p8>;
		pinctrl-names = "default";
		pinctrl-0 = <&disp0_ctrl_state>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				ws_bridge_in: endpoint {
					data-lanes = <1 2>;
					remote-endpoint = <&mdss_dsi0_out>;
				};
			};

			port@1 {
				reg = <1>;

				ws_bridge_out: endpoint {
					remote-endpoint = <&ws_panel_in>;
				};
			};
		};
	};
};

/ {
	/*
	 * Dumb DPI panel behind the bridge. Timings are the vendor's 1280x800 60 Hz
	 * mode (shared by their 8" and 10.1" panels): 83.333 MHz pixel clock,
	 * h 1280 +156 +20 +40, v 800 +40 +48 +40.
	 */
	panel {
		compatible = "waveshare,23448", "panel-dpi";
		power-supply = <&vreg_l18b_1p8>;
		width-mm = <171>;
		height-mm = <107>;

		panel-timing {
			clock-frequency = <83333000>;
			hactive = <1280>;
			hfront-porch = <156>;
			hsync-len = <20>;
			hback-porch = <40>;
			vactive = <800>;
			vfront-porch = <40>;
			vsync-len = <48>;
			vback-porch = <40>;
			hsync-active = <0>;
			vsync-active = <0>;
			de-active = <1>;
			pixelclk-active = <1>;
		};

		port {
			ws_panel_in: endpoint {
				remote-endpoint = <&ws_bridge_out>;
			};
		};
	};
};

&tlmm {
	/* DISP0 panel reset (61, active low) + backlight enable (39), applied at bridge probe. */
	disp0_ctrl_state: disp0-ctrl-state {
		pins = "gpio61", "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	/* DISP0 outputs this panel does not use: STBY/PDN(96), START(38). */
	disp0_misc_state: disp0-misc-state {
		pins = "gpio96", "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	/* DISP0 status inputs: ADP_PRESENT(105), RDY/INT(36). */
	disp0_status_state: disp0-status-state {
		pins = "gpio105", "gpio36";
		function = "gpio";
		bias-pull-up;
	};

	/* RGB status LED channels: RED(117), GREEN(84), BLUE(125). */
	rgb_led_state: rgb-led-state {
		pins = "gpio117", "gpio84", "gpio125";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

&venus {
	status = "okay";
};

/*
 * Sever the DP<->qmpphy of-graph link on both ends so a DP lookup returns a clean
 * -ENODEV: there is no Type-C connector here, and the qmpphy DP aux_bridge would
 * otherwise make DP defer forever, leaving the DPU without /dev/dri/card0. DP itself
 * is only enabled by the camx overlay, so this is inert otherwise. It lives here
 * rather than in the overlay because overlays cannot delete base tree properties.
 */
&mdss_dp_out {
	/delete-property/ remote-endpoint;
};

&usb_dp_qmpphy_dp_in {
	/delete-property/ remote-endpoint;
};
