/dts-v1/;

#include "qcs6490-citron-som.dtsi"
#include "qcs6490-citron-common.dtsi"
#include <dt-bindings/leds/common.h>

/ {
	model = "8devices Robonode Vision";
	compatible = "8devices,robovision", "8devices,citron",
		"qcom,qcm6490";

	/*
	 * Cell 0 <unused:8 major:8 minor:8 platform_type:8>, cell 1 <ddr_class:3
	 * subtype:8>. The DDR class is mandatory: UEFI compares it for equality, and
	 * with no match it falls back to its built-in RB3gen2 tree, which has no eMMC
	 * node, so the rootfs never appears. Must agree with the flashed CDT, and a
	 * board with different DRAM needs a different value.
	 */
	qcom,board-id = <0x00010020 0x642>;

	/* Common-anode LED, cathodes low-side switched by N-FETs, hence active-HIGH. */
	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&rgb_led_state>;

		led-red {
			gpios = <&tlmm 117 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};

		led-green {
			gpios = <&tlmm 84 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};

		led-blue {
			gpios = <&tlmm 125 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_INDICATOR;
			default-state = "off";
		};
	};
};

/*
 * Roles are FIXED, not OTG: no USB_ID/CC path reaches the SoC. USB0 stays a device
 * to match the bootrom EDL/fastboot path, USB1 a host with +5V always on.
 */
&usb_1 {
	dr_mode = "peripheral";
};

/*
 * USB1 is HS-only host. The stock usb-role-switch targets the disabled EUD, so drop
 * it; the port node stays because eud_ep references it by phandle.
 */
&usb_2 {
	dr_mode = "host";
	/delete-property/ usb-role-switch;
	status = "okay";
};

/* UCS2113 load-switch enables; the regulators below hold USB0 off and USB1 on. */
&tlmm {
	usb0_vbus_en_state: usb0-vbus-en-state {
		pins = "gpio52";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	usb1_vbus_en_state: usb1-vbus-en-state {
		pins = "gpio53";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};

/ {
	usb0_vbus: regulator-usb0-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB0_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&tlmm 52 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_vbus_en_state>;
	};

	usb1_vbus: regulator-usb1-vbus {
		compatible = "regulator-fixed";
		regulator-name = "USB1_VBUS";
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
		gpio = <&tlmm 53 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		regulator-always-on;
		regulator-boot-on;
		pinctrl-names = "default";
		pinctrl-0 = <&usb1_vbus_en_state>;
	};
};

&tlmm {
	eeprom_wc_state: eeprom-wc-state {
		pins = "gpio46";
		function = "gpio";
		bias-disable;
	};
};

/*
 * PCIe1 (x2) -> on-carrier QCN9274 Wi-Fi. Rails are hardware-sequenced and the
 * refclk is internal, so no regulator/clock/endpoint node is needed.
 */
&tlmm {
	pcie1_reset_n: pcie1-reset-n-state {
		pins = "gpio81";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-disable;
	};

	pcie1_wake_n: pcie1-wake-n-state {
		pins = "gpio80";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
	};
};

&pcie1 {
	perst-gpios = <&tlmm 81 GPIO_ACTIVE_LOW>;
	wake-gpios = <&tlmm 80 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&pcie1_reset_n>, <&pcie1_wake_n>, <&pcie1_clkreq_n>;
	status = "okay";
};

/*
 * PCIe0 (x1) -> PI7C9X2G304EV switch -> 2x RTL8111K. No WAKE: the downstream WAKE#
 * nets are per-NIC PME, not the link wake.
 */
&tlmm {
	pcie0_reset_n: pcie0-reset-n-state {
		pins = "gpio86";
		function = "gpio";
		drive-strength = <16>;
		output-low;
		bias-disable;
	};
};

/* Camera comes from a CAMERA_STACK overlay, which also enables camcc. */

&tlmm {
	disp0_ctrl_state: disp0-ctrl-state {
		pins = "gpio61", "gpio39";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
		output-high;
	};

	/* Nothing references these two; they just park the remaining DISP0 pins. */
	disp0_misc_state: disp0-misc-state {
		pins = "gpio96", "gpio38";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};

	disp0_status_state: disp0-status-state {
		pins = "gpio105", "gpio36";
		function = "gpio";
		bias-pull-up;
	};

	rgb_led_state: rgb-led-state {
		pins = "gpio117", "gpio84", "gpio125";
		function = "gpio";
		drive-strength = <2>;
		bias-disable;
	};
};
