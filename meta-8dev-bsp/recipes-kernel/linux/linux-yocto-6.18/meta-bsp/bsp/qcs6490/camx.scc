# SPDX-License-Identifier: MIT
define KFEATURE_DESCRIPTION "QCS6490 CAMX downstream Spectra camera stack"
define KFEATURE_COMPATIBILITY all

# CAMX runs its IQ nodes on the GPU and feeds UBWC buffers to the Iris encoder.
# dma-buf heaps and the interconnect framework come from bsp/qcs6490/soc.scc.
include cfg/8dev/v4l2.scc
include bsp/qcs6490/camcc.scc
include bsp/qcs6490/remoteproc.scc
include bsp/qcs6490/gpu.scc
include bsp/qcs6490/iris.scc

kconf hardware camx.cfg
