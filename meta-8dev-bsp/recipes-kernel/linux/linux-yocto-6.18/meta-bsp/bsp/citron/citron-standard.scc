# SPDX-License-Identifier: MIT
define KMACHINE citron
define KTYPE standard
define KARCH arm64
define KMETA_EXTERNAL_BSP t

include ktypes/8dev/standard.scc

# --- Upstream HW feature includes ---
include features/power/arm.scc
include features/mmc/mmc-block.scc
include features/i2c/i2c.scc
include features/spi/spi.scc
include features/pwm/pwm.scc
include features/pci/pci.scc
include features/usb/xhci-hcd.scc
include cfg/timer/rtc.scc

# --- SoC hardware ---
include bsp/qcs6490/soc.scc
include bsp/qcs6490/serial.scc
include bsp/qcs6490/thermal.scc
include bsp/qcs6490/watchdog.scc
include bsp/qcs6490/crypto.scc
include bsp/qcs6490/pcie.scc
include bsp/qcs6490/usb.scc
include bsp/qcs6490/usb-phy.scc
include bsp/qcs6490/sdhci.scc
include bsp/qcs6490/ufs.scc

# --- SoM + carrier hardware ---
include bsp/citron/som.scc

# --- Hardware-agnostic policy ---
include cfg/8dev/gpio.scc
include cfg/8dev/leds-gpio.scc
include cfg/8dev/ubifs.scc
include cfg/8dev/usb-gadget.scc
include cfg/8dev/usb-classes.scc

# --- Patches ---
# All in one place: linux-8dev carries the same set in git and includes this file
# with nopatch. Feature-specific ones are harmless without their feature.
patch patches/qcom-socinfo-add-qcs6490-soc-id.patch
patch patches/pci-qcom-force-synchronous-probe.patch
patch patches/qcom-scm-reboot-edl-enters-download-mode.patch
patch patches/media-qcom-camss-bind-sensors-independently.patch
# The waveshare bridge attaches its DSI peripheral from bridge_attach, which never
# completes on msm (component-framework DSI host).
patch patches/drm-waveshare-attach-dsi-in-probe.patch
# Promptless select-only symbols that iris-video-dlkm / kgsl-dlkm need enabled.
patch patches/qcom-ubwc-config-selectable.patch
patch patches/interval-tree-selectable.patch
# CPAS constants qcs6490-camera.dtsi needs; mainline does not carry the header.
patch patches/dt-bindings-camera-add-msm-camera-header.patch
